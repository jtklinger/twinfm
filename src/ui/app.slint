import { Pane, Row, TabInfo, Crumb, StatusInfo, GridRow, Tile, StripRow, ToolState, Toolbar, Paging } from "pane.slint";
import { ListView, AboutSlint } from "std-widgets.slint";
import { Theme, Btn, Switch, Field, Choice } from "theme.slint";
// Inter (SIL Open Font License 1.1, src/ui/fonts/OFL.txt), the face of the look (P10-M1 task 4):
// the three static weights the window uses, embedded in the exe.
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import { Preview, PreviewPage, MdBlock, MdRow, MdCell } from "preview.slint";
export { Row, TabInfo, Crumb, StatusInfo, GridRow, Tile, StripRow, ToolState, Paging, PreviewPage, MdBlock, MdRow, MdCell }
// The fluent Palette, for main.rs's TWINFM_SCHEME override (a scripted screenshot of the other scheme).
export { Palette } from "std-widgets.slint";

// One sidebar row (sidebar.rs Row): kind 0 section header, 1 drive, 2 place, 3 bookmark; index is
// the bookmark's index in the bookmark list.
export struct SideItem {
    label: string,
    kind: int,
    index: int,
}

component SideRow inherits Rectangle {
    in property <SideItem> item;
    // The row's inline title editor is open ("Rename bookmark").
    in property <bool> editing;
    // The row was clicked last and the sidebar has the keys (F2 renames a bookmark row).
    in property <bool> current;
    // clicked(middle): the left or the middle button released over the row.
    callback clicked(bool);
    // menu(x, y): the right button released over a bookmark, at window coordinates.
    callback menu(length, length);
    // renamed(title): Return in the editor. edit-cancelled(refocus): Escape (true) or focus loss.
    callback renamed(string);
    callback edit-cancelled(bool);
    height: 32px;
    background: transparent;
    accessible-role: list-item;
    accessible-label: item.label;
    // The fill, inset 4 px and rounded, inside the row's slot (P10-M1).
    Rectangle { x: 4px; width: parent.width - 8px; border-radius: Theme.radius; background: root.current ? Theme.selection : item.kind != 0 && ta.has-hover ? Theme.muted-half : transparent; }
    HorizontalLayout {
        visible: !root.editing;
        padding-left: item.kind == 0 ? 8px : 10px;
        padding-right: 6px;
        spacing: 8px;
        // The row's icon (P10-M1): drives, bookmarks, and the known places by their label.
        if item.kind != 0: Rectangle {
            width: 16px;
            Image { y: (parent.height - 16px) / 2; width: 16px; height: 16px; colorize: Theme.fg-muted; source: item.kind == 1 ? @image-url("icons/hard-drive.svg") : item.kind == 3 ? @image-url("icons/star.svg") : item.label == "Home" ? @image-url("icons/house.svg") : item.label == "Desktop" ? @image-url("icons/monitor.svg") : item.label == "Downloads" ? @image-url("icons/download.svg") : item.label == "Pictures" ? @image-url("icons/image.svg") : item.label == "Music" ? @image-url("icons/music.svg") : item.label == "Videos" ? @image-url("icons/film.svg") : item.label == "OneDrive" ? @image-url("icons/cloud.svg") : @image-url("icons/folder.svg"); }
        }
        Text {
            text: item.label;
            vertical-alignment: item.kind == 0 ? bottom : center;
            overflow: elide;
            font-weight: item.kind == 0 || root.current ? 500 : 400;
            font-size: item.kind == 0 ? 12px : 13px;
            color: item.kind == 0 ? Theme.fg-muted : Theme.fg;
        }
    }
    // Exists only while the row is being renamed; takes the focus with the title selected.
    if root.editing: Field {
        x: 8px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.item.label;
        label: "Bookmark title";
        init => {
            self.focus();
            self.select-all();
        }
        accepted(t) => { root.renamed(t); }
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.edit-cancelled(true); return accept; }
            return reject;
        }
        changed has-focus => {
            if (!self.has-focus) { root.edit-cancelled(false); }
        }
    }
    ta := TouchArea {
        enabled: item.kind != 0 && !root.editing;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) { root.clicked(false); }
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.middle) { root.clicked(true); }
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.right && item.kind == 3) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// One item of TwinFM's own popup menus; a disabled item is dimmed and takes no clicks.
component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback activated();
    height: 26px;
    background: ta.has-hover && root.enabled ? Theme.muted : transparent;
    accessible-role: button;
    accessible-label: root.text;
    Text {
        x: 10px;
        text: root.text;
        vertical-alignment: center;
        color: root.enabled ? Theme.fg : Theme.fg-faint;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
}

// One row of the Windows 11 style context menu or its submenu (P7-M2, winmenu.rs): an item with
// its icon (the app's own, or a Segoe Fluent Icons glyph), text, key and submenu chevron, or a
// separator. `y` is its top in the list, set from Rust (winmenu::rows_y).
export struct MenuEntry {
    id: int,
    text: string,
    glyph: string,
    icon: image,
    has-icon: bool,
    key: string,
    sub: bool,
    enabled: bool,
    sep: bool,
    y: length,
}

// One button of the menu's icon row.
export struct MenuTool {
    id: int,
    glyph: string,
    text: string,
}

component MenuRow inherits Rectangle {
    in property <MenuEntry> entry;
    in property <bool> hl;
    callback picked();
    callback hovered();
    height: root.entry.sep ? 9px : 30px;
    if root.entry.sep: Rectangle {
        x: 8px; y: 4px; width: parent.width - 16px; height: 1px;
        background: Theme.border;
    }
    if !root.entry.sep: Rectangle {
        border-radius: Theme.radius;
        background: (root.hl || ta.has-hover) && root.entry.enabled ? Theme.muted : transparent;
        accessible-role: button;
        accessible-label: root.entry.text;
        if root.entry.has-icon: Image {
            x: 12px; y: (parent.height - 16px) / 2; width: 16px; height: 16px;
            source: root.entry.icon;
            opacity: root.entry.enabled ? 1 : 0.45;
        }
        if !root.entry.has-icon: Text {
            x: 12px; width: 16px;
            text: root.entry.glyph;
            font-family: "Segoe Fluent Icons";
            font-size: 15px;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: root.entry.enabled ? Theme.fg : Theme.fg-faint;
        }
        Text {
            x: 40px; width: parent.width - 40px - (root.entry.key != "" || root.entry.sub ? 96px : 12px);
            text: root.entry.text;
            vertical-alignment: center;
            overflow: elide;
            color: root.entry.enabled ? Theme.fg : Theme.fg-faint;
        }
        Text {
            x: parent.width - 96px; width: 84px;
            text: root.entry.sub ? "\u{E76C}" : root.entry.key;
            font-family: root.entry.sub ? "Segoe Fluent Icons" : "";
            font-size: root.entry.sub ? 11px : 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: Theme.fg-muted;
        }
        ta := TouchArea {
            enabled: root.entry.enabled;
            clicked => { root.picked(); }
            changed has-hover => {
                if (self.has-hover) { root.hovered(); }
            }
        }
    }
}

component MenuToolButton inherits Rectangle {
    in property <MenuTool> tool;
    callback picked();
    width: 44px;
    height: 36px;
    border-radius: Theme.radius;
    background: ta.has-hover ? Theme.muted : transparent;
    accessible-role: button;
    accessible-label: root.tool.text;
    // The Lucide set by the button's name (P10-M3); winmenu.rs's glyph is left as it is.
    Image {
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        colorize: Theme.fg;
        source: root.tool.text == "Cut" ? @image-url("icons/scissors.svg") : root.tool.text == "Copy" ? @image-url("icons/copy.svg") : root.tool.text == "Rename" ? @image-url("icons/pencil.svg") : root.tool.text == "Share" ? @image-url("icons/share.svg") : root.tool.text == "Delete" ? @image-url("icons/trash.svg") : @image-url("icons/clipboard-paste.svg");
    }
    ta := TouchArea { clicked => { root.picked(); } }
}

export component App inherits Window {
    // "TwinFM - <folder>" for the active pane's active tab.
    title: "TwinFM - " + (split && active-pane == 1 ? right-title : left-title);
    icon: @image-url("../../assets/icon/png/twinfm-256.png");
    // The look (P10-M1): Inter, embedded above; 13 px for rows and controls.
    default-font-family: "Inter";
    default-font-size: 13px;
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 400px;
    min-height: 300px;

    in property <[Row]> left-rows;
    in property <[Row]> right-rows;
    // The icon grid per pane (settings `view_left` / `view_right`; Ctrl+Shift+1 details,
    // Ctrl+Shift+2 large icons, Ctrl+Shift+3 medium icons): its rows (model.rs GridModel over the
    // pane's entries) and, read by Rust for hit testing, the tiles to a grid row the pane's list
    // fits; `medium` picks the medium tiles (settings `tile_left` / `tile_right`).
    in property <bool> left-grid: false;
    in property <bool> right-grid: false;
    in property <bool> left-medium: false;
    in property <bool> right-medium: false;
    in property <[GridRow]> left-grid-rows;
    in property <[GridRow]> right-grid-rows;
    out property <int> left-grid-cols: left.tiles-per-row;
    out property <int> right-grid-cols: right.tiles-per-row;
    // The grid's icon strip per pane: one image per grid row (main.rs `grid_slots`).
    in property <[StripRow]> left-strip-rows;
    in property <[StripRow]> right-strip-rows;
    in property <string> left-path;
    in property <string> right-path;
    in property <StatusInfo> left-status;
    in property <StatusInfo> right-status;
    in property <[TabInfo]> left-tabs;
    in property <[TabInfo]> right-tabs;
    in property <[Crumb]> left-crumbs;
    in property <[Crumb]> right-crumbs;
    // The path bars show the text entry for good instead of the breadcrumb (the toggle glyph).
    in-out property <bool> path-entry-sticky: false;
    // The window title's folder name for each pane (its active tab's).
    in property <string> left-title;
    in property <string> right-title;
    // The sidebar: its rows, shown or collapsed to a strip, and its width.
    in property <[SideItem]> side-items;
    in-out property <bool> sidebar-visible: true;
    in-out property <length> sidebar-width: 180px;
    // The toolbar (P6-M3, settings `toolbar`): 0 none, 1 across the window under the title (labelled,
    // acting on the active pane), 2 inside each pane above its path bar (icons only, acting on that
    // pane). Each pane's button state (toolbar.rs `state`), and toolbar-clicked(pane, name) for a
    // press (main.rs makes the pane active and focuses its list, or lets the name editor take it).
    in property <int> toolbar: 1;
    in property <ToolState> left-tools;
    in property <ToolState> right-tools;
    callback toolbar-clicked(int, string);
    // toolbar-tip(pane, text): a toolbar button's tooltip showed (pane -1: the bar across the window).
    callback toolbar-tip(int, string);
    private property <length> top-h: root.toolbar == 1 ? 44px : 0px;
    // For the About dialog (CARGO_PKG_VERSION).
    in property <string> version;
    // The Type column in both panes (settings `show_type`; set at start and by the dialog).
    in property <bool> show-type: true;
    // Each pane's Type, Size and Modified widths in the details list (P9-M1; settings
    // `col_type_left` and the rest), set from Rust at start and by the grips.
    in property <length> left-col-type: 120px;
    in property <length> left-col-size: 90px;
    in property <length> left-col-modified: 140px;
    in property <length> right-col-type: 120px;
    in property <length> right-col-size: 90px;
    in property <length> right-col-modified: 140px;
    // col-drag(pane, col, dx, phase) and col-fit(pane, col): a header grip (pane.slint ColGrip).
    callback col-drag(int, int, length, int);
    callback col-fit(int, int);
    // Thumbnails and 32 px rows in both panes (settings `thumbnails`; set at start and by the dialog).
    in property <bool> thumbnails: false;
    in property <int> left-sort-col;
    in property <bool> left-sort-asc;
    in property <int> right-sort-col;
    in property <bool> right-sort-asc;
    in-out property <bool> split: false;
    in-out property <int> active-pane: 0;
    in-out property <float> split-ratio: 0.5;
    in-out property <int> left-current-row: -1;
    in-out property <int> right-current-row: -1;
    // The preview column at the window's right edge (P8-M1, settings `preview`): its width as a
    // share of the space right of the sidebar (`preview_width`, 0.2 to 0.6, its handle's drag sets
    // it), and what preview.rs puts in it. toggle-preview(): Alt+P (the toolbar's button goes
    // through Rust). preview-cursor(): a pane's cursor row or the active pane changed while the
    // column shows (preview.rs restarts its settle timer; nothing else). preview-scrolled(top,
    // visible height) and preview-resized(page width): the column's scroll and width.
    in-out property <bool> preview: false;
    in-out property <float> preview-width: 0.35;
    in property <string> preview-title;
    in property <string> preview-message;
    in property <[PreviewPage]> preview-pages;
    in property <length> preview-content-h;
    // Since P8-M2: 0 a PDF's pages, 1 a Markdown file's blocks; preview-link(destination) a link
    // clicked in one.
    in property <int> preview-mode;
    in property <[MdBlock]> preview-blocks;
    callback preview-link(string);
    // Since P11-M4: a PDF's zoom (percent, saved; preview-zoom-step(step) Ctrl+wheel over the pages,
    // preview-zoom-key(step) Ctrl+plus, minus or 0, which Rust takes only with the pointer over the
    // column), and "Copy text": preview-menu(block) a right-click on a block, preview-copy(block,
    // -1 for all) the menu's pick.
    in-out property <int> preview-zoom: 100;
    callback preview-zoom-step(int) -> bool;
    callback preview-zoom-key(int) -> bool;
    callback preview-menu(int);
    callback preview-copy(int);
    callback toggle-preview();
    callback preview-cursor();
    callback preview-scrolled(length, length);
    callback preview-resized(length);
    changed left-current-row => { if (root.preview) { root.preview-cursor(); } }
    changed right-current-row => { if (root.preview) { root.preview-cursor(); } }
    changed active-pane => { if (root.preview) { root.preview-cursor(); } }
    public function preview-set-scroll(y: length) { preview-col.set-scroll(y); }
    public function preview-scroll-top() -> length { return preview-col.scroll-top(); }
    public function preview-visible-h() -> length { return preview-col.visible-h(); }
    public function preview-total-h() -> length { return preview-col.total-h(); }
    // A drag over the window would drop into pane `drop-pane` (-1: none), on row `drop-row` (-1:
    // the pane's folder). Set by the drop target (dnd.rs).
    in-out property <int> drop-pane: -1;
    in-out property <int> drop-row: -1;
    // A drag would drop on tab `drop-tab` of pane `drop-tab-pane` (-1: none), or on sidebar row
    // `drop-side-row` (-1: none), whose top in the sidebar list and height are drop-side-y and
    // drop-side-h. Set by the drop target through main.rs `drop_highlight`, on change only.
    in-out property <int> drop-tab-pane: -1;
    in-out property <int> drop-tab: -1;
    in-out property <int> drop-side-row: -1;
    in-out property <length> drop-side-y;
    in-out property <length> drop-side-h;
    // A drag would drop on crumb `drop-crumb` of pane `drop-crumb-pane`'s breadcrumb (-1: none).
    in-out property <int> drop-crumb-pane: -1;
    in-out property <int> drop-crumb: -1;
    // The rubber band (P4-M3): in pane band-pane (-1: none), the rectangle in that list's content
    // coordinates. Set by main.rs while a band gesture runs.
    in-out property <int> band-pane: -1;
    in-out property <length> band-x;
    in-out property <length> band-y;
    in-out property <length> band-w;
    in-out property <length> band-h;
    // band-pointer(pane, kind, window x, window y, ctrl, shift): the left button on a grid pane's
    // empty space (kind 0 down, 1 move, 2 up, 3 cancel).
    callback band-pointer(int, int, length, length, bool, bool);
    // The drag threshold in logical px (SM_CXDRAG / SM_CYDRAG over the scale factor).
    in property <length> drag-dx: 4px;
    in property <length> drag-dy: 4px;

    callback navigate(int, string);
    callback open-row(int, int);
    callback sort-by(int, int);
    callback go-up(int);
    // pane-back(pane), pane-forward(pane): the mouse's Back or Forward button released over that
    // pane (not necessarily the active one): it becomes active and goes back or forward in its
    // active tab's history. pane-history(pane, forward): Alt+Left / Alt+Right in its list.
    callback pane-back(int);
    callback pane-forward(int);
    callback pane-history(int, bool);
    callback toggle-split();
    callback toggle-hidden(int);
    callback refresh(int);
    // select(pane, op, row): op 0 only this row, 1 toggle, 2 range from anchor, 3 all, 4 right-click, 5 clear (model::SelOp)
    callback select(int, int, int);
    // viewport-changed(pane, content-y, visible-height)
    callback viewport-changed(int, length, length);
    // grid-cols(pane, n): the pane's grid now fits n tiles to a grid row; grid-cursor(pane, row):
    // its cursor entry changed; set-view(pane, view): Ctrl+Shift+1 (0, details), Ctrl+Shift+2 (1,
    // large icons) or Ctrl+Shift+3 (2, medium icons) for the active pane.
    callback grid-cols(int, int);
    callback grid-cursor(int, int);
    callback set-view(int, int);
    // command(pane, name): a file operation key in that pane's list (pane.slint FileList).
    callback command(int, string);
    // edit-commit(pane, mode, original, typed): the inline name editor's Return.
    callback edit-commit(int, int, string, string);
    // context-menu(pane, row, x, y, shift): right-click on a row (row >= 0) or below the last row
    // (-1), window-relative logical coordinates. context-key(pane, row, list x, list y, content-y,
    // visible-height): Shift+F10 or the Menu key.
    callback context-menu(int, int, length, length, bool);
    callback context-key(int, int, length, length, length, length);
    // row-gesture(pane, row, what, ctrl, shift): left press (0), release (1), drag past the
    // threshold (2) or double-click (3) on a row, or a middle (4) or Back (5) button release, or a
    // move past the threshold with the right button down (6, a right-button drag), or a Forward
    // button release (7); see pane.slint
    // FileListBase.
    callback row-gesture(int, int, int, bool, bool);
    // tab-select(pane, index), tab-close(pane, index): a click or middle-click in a tab strip.
    callback tab-select(int, int);
    callback tab-close(int, int);
    // tab-move(pane, from, to): a tab dragged within its strip.
    callback tab-move(int, int, int);
    // strip-resized(pane): the pane's tab strip changed width; Rust reveals the active tab again.
    callback strip-resized(int);
    // tab-key(pane, what): for the active pane, Ctrl+T "new", Ctrl+W "close", Ctrl+Tab "next",
    // Ctrl+Shift+Tab "prev", Ctrl+1..9 "1".."9", Ctrl+Shift+PageUp "moveleft",
    // Ctrl+Shift+PageDown "moveright".
    callback tab-key(int, string);
    // crumb-clicked(pane, index): a breadcrumb button.
    callback crumb-clicked(int, int);
    // crumb-menu(pane, index, x, y): the chevron after a crumb; Rust lists its subfolders on a
    // worker and shows the dropdown below (x, y). crumb-pick(i): item i of the dropdown.
    callback crumb-menu(int, int, length, length);
    // history-menu(pane, x, y): a right click on the path bar's background (P11-M3).
    callback history-menu(int, length, length);
    callback crumb-pick(int);
    // crumb-geometry(pane, index, x, width): a crumb's place in its row (index -1: the row's offset
    // in the bar and the bar's width), for the drop target's hit test (main.rs `crumb_geometry`).
    callback crumb-geometry(int, int, length, length);
    // side-clicked(row, middle): a sidebar row; the middle button opens it in a new tab.
    callback side-clicked(int, bool);
    // side-step(row, key): the sidebar's Up, Down, Home, End or Return with `row` current (-1:
    // none); the row current after it (sidebar.rs `step`; Return opens the row and keeps it).
    // side-row-top(row): the row's top in the sidebar list's content.
    callback side-step(int, string) -> int;
    pure callback side-row-top(int) -> length;
    // bookmark-add(): Ctrl+D. bookmark-remove(index): the bookmark menu's "Remove bookmark".
    // bookmark-rename(index, title): the row's editor, opened by "Rename bookmark" (an empty
    // title goes back to the folder's name). bookmark-move(index, up): "Move up" / "Move down".
    callback bookmark-add();
    callback bookmark-remove(int);
    callback bookmark-rename(int, string);
    callback bookmark-move(int, bool);
    // How many bookmarks there are (for the menu's move items), and the sidebar row whose title
    // editor is open (-1: none).
    in property <int> bookmark-count;
    in-out property <int> side-edit: -1;
    // The sidebar row clicked last (-1: none). A left click on a row gives the sidebar the keys,
    // as Explorer's navigation pane takes them (P6-M3): F2 on a bookmark opens its title editor,
    // Escape and Tab give the keys back to the active pane's list, and a click in a list takes them.
    private property <int> side-current: -1;
    // A sidebar row's left click (and the driver's `sidebar click`): the row becomes current, the
    // sidebar takes the keys, the row's folder opens in the active pane.
    public function side-click(i: int) {
        root.side-current = i;
        side-keys.focus();
        root.side-clicked(i, false);
    }
    // The name filter in each pane (pane.slint): whether its box shows and its text, set from Rust
    // on a tab switch and a navigation. filter-edited(pane, text): an edit (applied 150 ms after the
    // last one); filter-apply(pane, text): Return or Down in the box (at once; with a search waiting
    // for its pattern, the search starts); filter-clear(pane): Escape or the clear glyph.
    // search(pane): Ctrl+Shift+F, a recursive name search for the box's text in a new tab.
    in-out property <bool> left-filter-open;
    in-out property <string> left-filter-text;
    in-out property <bool> right-filter-open;
    in-out property <string> right-filter-text;
    callback filter-edited(int, string);
    callback filter-apply(int, string);
    callback filter-clear(int);
    // filter-return(pane, text): Return in the search box (P10-M2); search-pressed(pane): its button.
    callback filter-return(int, string);
    callback search-pressed(int);
    // The box's content toggle (P11-M1): the pane's mode, and content-toggled(pane, on) after a flip.
    in-out property <bool> left-content-mode;
    in-out property <bool> right-content-mode;
    callback content-toggled(int, bool);
    callback search(int);
    // Ctrl+F, and Rust when a search waits for its pattern: the pane's filter box, focused.
    public function open-filter(p: int) {
        if (p == 0) { left.open-filter(); } else { right.open-filter(); }
    }
    // sidebar-toggled(): F9 or a sidebar glyph changed sidebar-visible.
    callback sidebar-toggled();
    // settings-changed(): the split line, the sidebar width or the path bar mode moved; Rust
    // saves the settings 500 ms after the last call.
    callback settings-changed();

    public function toggle-sidebar() {
        sidebar-visible = !sidebar-visible;
        root.sidebar-toggled();
    }

    public function show-about() { about.show(); }
    public function close-about() { about.close(); }

    // The settings dialog. settings-requested(): Ctrl+, or "Settings" in the sidebar; Rust copies
    // the live values into the dlg-* properties and calls show-settings. The controls stage their
    // values there through settings-stage; settings-closed(ok) tells Rust to apply them (OK) or to
    // drop them (Cancel, Escape). Nothing is applied while the dialog is open.
    callback settings-requested();
    callback settings-closed(bool);
    in-out property <string> dlg-start-left;
    in-out property <string> dlg-start-right;
    in-out property <bool> dlg-hidden-left;
    in-out property <bool> dlg-hidden-right;
    // Protected operating system files (hidden and system both) per pane, shown with hidden files.
    in-out property <bool> dlg-protected-left;
    in-out property <bool> dlg-protected-right;
    // Each pane's view in the dialog: 0 details, 1 large icons, 2 medium icons (ComboBox index).
    in-out property <int> dlg-view-left;
    in-out property <int> dlg-view-right;
    in-out property <bool> dlg-type-column;
    in-out property <bool> dlg-thumbnails;
    in-out property <bool> dlg-sidebar;
    in-out property <bool> dlg-crumbs;
    // The toolbar's place in the dialog: 0 none, 1 top, 2 in each pane (ComboBox index).
    in-out property <int> dlg-toolbar;
    // The colour scheme choice (P10-M1 task 7): 0 system, 1 light, 2 dark.
    in-out property <int> dlg-theme;
    in-out property <bool> dlg-preview;
    // "Saved to <file>", or that a scripted run saves nothing.
    in property <string> settings-note;
    private property <bool> settings-shown: false;
    // Bumped after each show: the dialog then puts the focus in its first field (see there).
    private property <int> settings-focus-token: 0;
    public function show-settings() {
        settings-shown = true;
        settings-dialog.show();
        settings-focus-token += 1;
    }
    function finish-settings(ok: bool) {
        settings-dialog.close();
        settings-shown = false;
        root.settings-closed(ok);
        root.focus-pane(root.active-pane);
    }
    public function settings-ok() { finish-settings(true); }
    public function settings-cancel() { finish-settings(false); }
    // What each control calls when the user changes it (and the driver's `settings set`): field
    // start_left, start_right (a path), hidden_left, hidden_right, protected_left, protected_right,
    // type_column, thumbnails, sidebar ("true" or "false"), path_bar ("entry" or "crumb"), view_left,
    // view_right ("details", "large" or "medium"), toolbar ("top", "pane" or "none"), preview (P8-M1, "true" or "false").
    public function settings-stage(field: string, value: string) {
        if (field == "start_left") { dlg-start-left = value; }
        if (field == "start_right") { dlg-start-right = value; }
        if (field == "hidden_left") { dlg-hidden-left = value == "true"; }
        if (field == "hidden_right") { dlg-hidden-right = value == "true"; }
        if (field == "protected_left") { dlg-protected-left = value == "true"; }
        if (field == "protected_right") { dlg-protected-right = value == "true"; }
        if (field == "type_column") { dlg-type-column = value == "true"; }
        if (field == "thumbnails") { dlg-thumbnails = value == "true"; }
        if (field == "sidebar") { dlg-sidebar = value == "true"; }
        if (field == "path_bar") { dlg-crumbs = value != "entry"; }
        if (field == "view_left") { dlg-view-left = value == "medium" ? 2 : value == "large" ? 1 : 0; }
        if (field == "view_right") { dlg-view-right = value == "medium" ? 2 : value == "large" ? 1 : 0; }
        if (field == "toolbar") { dlg-toolbar = value == "none" ? 0 : value == "pane" ? 2 : 1; }
        if (field == "theme") { dlg-theme = value == "light" ? 1 : value == "dark" ? 2 : 0; }
        if (field == "preview") { dlg-preview = value == "true"; }
    }

    // The breadcrumb dropdown's contents and place, set from Rust before show-crumb-menu.
    in property <[string]> crumb-menu-items;
    in property <string> crumb-menu-note;
    in property <length> crumb-menu-x;
    in property <length> crumb-menu-y;
    // The dropdown's keyboard (P6-M3): the highlighted folder (-1: none yet; Down enters the list,
    // Up and Down move along it, Return picks, Escape closes), and a token bumped after each show
    // so its key scope takes the focus (showing a popup gives the focus to nothing, as with the
    // settings dialog below).
    private property <int> crumb-hl: -1;
    private property <int> crumb-focus-token: 0;
    public function show-crumb-menu() {
        crumb-hl = -1;
        crumb-menu.show();
        crumb-focus-token += 1;
    }
    public function close-crumb-menu() { crumb-menu.close(); }

    // The Windows 11 style context menu (P7-M2): its rows, icon row and submenu, placed and
    // highlighted from Rust (winmenu.rs), which decides every pick, key and hover. The popup covers
    // the window, so a click outside the menu reaches its background (wm-dismissed) and nothing
    // under it; the menu and its submenu are drawn at (wm-x, wm-y) and (wm-sub-x, wm-sub-y).
    in property <[MenuTool]> wm-tools;
    in property <[MenuEntry]> wm-items;
    in property <[MenuEntry]> wm-sub-items;
    in property <length> wm-x;
    in property <length> wm-y;
    in property <length> wm-h;
    in property <length> wm-list-h;
    in property <bool> wm-sub-shown;
    in property <length> wm-sub-x;
    in property <length> wm-sub-y;
    in property <length> wm-sub-h;
    in property <length> wm-sub-list-h;
    in property <int> wm-hl: -1;
    in property <int> wm-sub-hl: -1;
    in-out property <length> wm-scroll;
    in-out property <length> wm-sub-scroll;
    // wm-picked(id): an item or icon-row button clicked; wm-hover(id, in-sub): the pointer entered
    // an item; wm-key(name): down, up, home, end, right, left, return, escape, more (Shift+F10);
    // wm-dismissed(): a press outside the menu.
    callback wm-picked(int);
    callback wm-hover(int, bool);
    callback wm-key(string);
    callback wm-dismissed();
    private property <int> wm-focus-token: 0;
    public function show-wm() {
        wm-popup.show();
        wm-focus-token += 1;
    }
    public function close-wm() { wm-popup.close(); }

    // Ctrl+L, and the driver's `pathmode`: the pane's path bar as text entry or breadcrumb.
    public function set-path-mode(p: int, entry: bool) {
        if (entry) {
            if (p == 0) { left.begin-path-entry(); } else { right.begin-path-entry(); }
        } else {
            if (p == 0) { left.end-path-entry(); } else { right.end-path-entry(); }
        }
    }

    public function focus-pane(p: int) {
        active-pane = p;
        if (p == 0) { left.focus-list(); } else { right.focus-list(); }
    }

    public function reset-scroll(p: int) {
        if (p == 0) { left.reset-scroll(); } else { right.reset-scroll(); }
    }

    // The pane's tab strip: scroll tab `i` into view (returns the strip's offset), and its tab
    // width and offset now (for the driver's tab drag).
    public function reveal-tab(p: int, i: int) -> length {
        return p == 0 ? left.reveal-tab(i) : right.reveal-tab(i);
    }
    public function tab-width(p: int) -> length { return p == 0 ? left.tab-w : right.tab-w; }
    public function tab-offset(p: int) -> length { return p == 0 ? left.shown-tab-scroll : right.shown-tab-scroll; }
    // A drag hovering an end of the pane's strip scrolls it (main.rs `drop_autoscroll`).
    public function set-tab-scroll(p: int, x: length) {
        if (p == 0) { left.tab-scroll = x; } else { right.tab-scroll = x; }
    }
    // The pane's path bar shows the text entry, not the breadcrumb (no crumb is a drop target).
    public function path-entry-shown(p: int) -> bool { return p == 0 ? left.path-entry : right.path-entry; }

    // The sidebar list's scroll offset (zero or negative), for the drop target's hit test.
    public function side-scroll() -> length { return side-list.content-y; }
    // A drag hovering the sidebar list's top or bottom scrolls it (main.rs `drop_autoscroll`).
    public function set-side-scroll(y: length) { side-list.content-y = y; }
    // Its rows' height and its viewport's, as the ListView has them (its rows differ in height,
    // so its content height is its own estimate, a px or two off the rows' sum).
    public function side-content-height() -> length { return side-list.content-height; }
    public function side-visible-height() -> length { return side-list.visible-height; }

    // The width of the widest line of `s` in the lists' font (bold: the header's), for a column fit
    // (P9-M1): the hidden Texts below take the text and Rust reads their preferred width at once.
    private property <string> measure-text;
    public function measure(s: string, bold: bool) -> length {
        root.measure-text = s;
        return bold ? measure-bold.preferred-width : measure-plain.preferred-width;
    }
    measure-plain := Text { visible: false; text: root.measure-text; accessible-role: none; }
    measure-bold := Text { visible: false; text: root.measure-text; font-weight: 600; accessible-role: none; }

    public function get-scroll(p: int) -> length {
        return p == 0 ? left.get-scroll() : right.get-scroll();
    }

    public function set-scroll(p: int, y: length) {
        if (p == 0) { left.set-scroll(y); } else { right.set-scroll(y); }
    }

    public function begin-edit(p: int, mode: int, text: string) {
        if (p == 0) { left.begin-edit(mode, text); } else { right.begin-edit(mode, text); }
    }

    // set-strip(pane, image, left x in the list, top of its first row in the list's content, width, height, shown):
    // the pane's icon strip.
    public function set-strip(p: int, img: image, left-x: length, top: length, w: length, h: length, shown: bool) {
        if (p == 0) { left.set-strip(img, left-x, top, w, h, shown); } else { right.set-strip(img, left-x, top, w, h, shown); }
    }

    forward-focus: outer;

    outer := FocusScope {
        key-pressed(e) => {
            // The list rejects Escape (it cancels queued jobs first); with the settings dialog
            // open it cancels the dialog, which closes on nothing else but OK and Cancel.
            if (e.text == Key.Escape && root.settings-shown) { root.settings-cancel(); return accept; }
            if (e.modifiers.control && !e.modifiers.shift && e.text == ",") {
                if (!root.settings-shown) { root.settings-requested(); }
                return accept;
            }
            if (e.text == Key.F3) { root.toggle-split(); return accept; }
            if (e.modifiers.control && (e.text == "h" || e.text == "H")) { root.toggle-hidden(active-pane); return accept; }
            if (e.text == Key.F5 || (e.modifiers.control && (e.text == "r" || e.text == "R"))) {
                root.refresh(active-pane);
                return accept;
            }
            if (e.text == Key.RightArrow && e.modifiers.control && e.modifiers.shift) {
                if (split) { root.focus-pane(1 - active-pane); }
                return accept;
            }
            if (e.modifiers.control && (e.text == Key.Tab || e.text == Key.Backtab)) {
                root.tab-key(active-pane, e.modifiers.shift || e.text == Key.Backtab ? "prev" : "next");
                return accept;
            }
            if (e.modifiers.control && e.modifiers.shift && (e.text == Key.PageUp || e.text == Key.PageDown)) {
                root.tab-key(active-pane, e.text == Key.PageUp ? "moveleft" : "moveright");
                return accept;
            }
            if (e.modifiers.control && !e.modifiers.shift && (e.text == "t" || e.text == "T")) { root.tab-key(active-pane, "new"); return accept; }
            // Ctrl+Z (since P11-M3, the list's until then) and Ctrl+Y from anywhere but the text boxes
            // (their own undo takes the key first) and the settings dialog.
            if (e.modifiers.control && !e.modifiers.shift && (e.text == "z" || e.text == "Z") && !root.settings-shown) { root.command(active-pane, "undo"); return accept; }
            if (e.modifiers.control && !e.modifiers.shift && (e.text == "y" || e.text == "Y") && !root.settings-shown) { root.command(active-pane, "redo"); return accept; }
            if (e.modifiers.control && !e.modifiers.shift && (e.text == "w" || e.text == "W")) { root.tab-key(active-pane, "close"); return accept; }
            if (e.modifiers.control && !e.modifiers.shift && (e.text == "1" || e.text == "2" || e.text == "3" || e.text == "4" || e.text == "5" || e.text == "6" || e.text == "7" || e.text == "8" || e.text == "9")) {
                root.tab-key(active-pane, e.text);
                return accept;
            }
            // Explorer's view keys. With Shift held a US keyboard reports the digit's shifted
            // character ("!", "@" and "#"); the driver sends the digit.
            if (e.modifiers.control && e.modifiers.shift && (e.text == "1" || e.text == "!")) { root.set-view(active-pane, 0); return accept; }
            if (e.modifiers.control && e.modifiers.shift && (e.text == "2" || e.text == "@")) { root.set-view(active-pane, 1); return accept; }
            if (e.modifiers.control && e.modifiers.shift && (e.text == "3" || e.text == "#")) { root.set-view(active-pane, 2); return accept; }
            if (e.modifiers.control && (e.text == "l" || e.text == "L")) { root.set-path-mode(active-pane, true); return accept; }
            // The preview's zoom, with the pointer over the column (P11-M4); "=" is plus unshifted.
            if (e.modifiers.control && !e.modifiers.alt && root.preview && (e.text == "+" || e.text == "=" || e.text == "-" || e.text == "0")) {
                if (root.preview-zoom-key(e.text == "-" ? -1 : e.text == "0" ? 0 : 1)) { return accept; }
            }
            if (e.modifiers.control && (e.text == "f" || e.text == "F")) {
                if (e.modifiers.shift) { root.search(active-pane); } else { root.open-filter(active-pane); }
                return accept;
            }
            if (e.text == Key.F9) { root.toggle-sidebar(); return accept; }
            // Alt+P: the preview column, as in Explorer (P8-M1).
            if (e.modifiers.alt && !e.modifiers.control && !e.modifiers.shift && (e.text == "p" || e.text == "P")) { root.toggle-preview(); return accept; }
            if (e.text == Key.F1) { root.show-about(); return accept; }
            if (e.modifiers.control && !e.modifiers.shift && (e.text == "d" || e.text == "D")) { root.bookmark-add(); return accept; }
            return reject;
        }
        // The toolbar across the window, over the sidebar and the panes (dnd.rs TOP_BAR).
        if root.toolbar == 1: Rectangle {
            x: 0; y: 0; width: parent.width; height: root.top-h;
            background: Theme.ground;
            // The mouse's Back and Forward buttons over the bar's gaps go to the active pane, as
            // over its buttons (P7-M4).
            TouchArea {
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.back) { root.pane-back(root.split && root.active-pane == 1 ? 1 : 0); }
                    if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.forward) { root.pane-forward(root.split && root.active-pane == 1 ? 1 : 0); }
                }
            }
            Toolbar {
                x: 4px; y: 2px; height: parent.height - 4px;
                tools: root.split && root.active-pane == 1 ? root.right-tools : root.left-tools;
                labelled: true;
                preview-on: root.preview;
                tool(c) => { root.toolbar-clicked(root.split && root.active-pane == 1 ? 1 : 0, c); }
                tip(t) => { root.toolbar-tip(-1, t); }
                back => { root.pane-back(root.split && root.active-pane == 1 ? 1 : 0); }
                forward => { root.pane-forward(root.split && root.active-pane == 1 ? 1 : 0); }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        sidebar := Rectangle {
            visible: sidebar-visible;
            x: 0; y: root.top-h; width: sidebar-width; height: parent.height - root.top-h;
            background: Theme.sidebar;
            // The renderer draws the whole window every frame; cached as one texture, the sidebar
            // costs a blit while the panes scroll and is redrawn only when its own properties change.
            cache-rendering-hint: true;
            side-keys := FocusScope {
                width: 0px;
                height: 0px;
                key-pressed(e) => {
                    if (e.text == Key.F2) {
                        if (root.side-current >= 0 && root.side-current < root.side-items.length && root.side-items[root.side-current].kind == 3) {
                            root.side-edit = root.side-current;
                        }
                        return accept;
                    }
                    if (e.text == Key.Escape || e.text == Key.Tab) {
                        root.focus-pane(root.active-pane);
                        return accept;
                    }
                    // Up, Down, Home and End move along the rows, past the headers; Return opens
                    // the row's folder in the active pane (P7-M4). The moved-to row is scrolled
                    // into view.
                    let k = e.text == Key.UpArrow ? "Up" : e.text == Key.DownArrow ? "Down" : e.text == Key.Home ? "Home" : e.text == Key.End ? "End" : e.text == Key.Return ? "Return" : "";
                    if (k != "" && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.shift) {
                        root.side-current = root.side-step(root.side-current, k);
                        if (root.side-current >= 0) {
                            let top = root.side-row-top(root.side-current);
                            if (top + side-list.content-y < 0px) { side-list.content-y = -top; }
                            if (top + 32px + side-list.content-y > side-list.visible-height) { side-list.content-y = side-list.visible-height - top - 32px; }
                        }
                        return accept;
                    }
                    return reject;
                }
            }
            VerticalLayout {
                padding-top: 3px;
                side-list := ListView {
                    accessible-label: "Places";
                    for item[i] in root.side-items: SideRow {
                        item: item;
                        editing: i == root.side-edit;
                        current: i == root.side-current && side-keys.has-focus;
                        clicked(middle) => {
                            if (middle) { root.side-clicked(i, true); } else { root.side-click(i); }
                        }
                        menu(x, y) => {
                            root.menu-index = item.index;
                            root.menu-row = i;
                            root.menu-x = x;
                            root.menu-y = y;
                            bookmark-menu.show();
                        }
                        renamed(t) => {
                            root.side-edit = -1;
                            root.bookmark-rename(item.index, t);
                            root.focus-pane(root.active-pane);
                        }
                        edit-cancelled(refocus) => {
                            root.side-edit = -1;
                            if (refocus) { root.focus-pane(root.active-pane); }
                        }
                    }
                }
                HorizontalLayout {
                    height: 32px;
                    padding-left: 8px;
                    padding-right: 4px;
                    spacing: 10px;
                    settings-ta := TouchArea {
                        width: 48px;
                        clicked => { if (!root.settings-shown) { root.settings-requested(); } }
                        Text {
                            text: "Settings";
                            font-size: 11px;
                            vertical-alignment: center;
                            color: settings-ta.has-hover ? Theme.fg : Theme.fg-muted;
                        }
                    }
                    about-ta := TouchArea {
                        clicked => { root.show-about(); }
                        Text {
                            text: "About TwinFM";
                            font-size: 11px;
                            vertical-alignment: center;
                            color: about-ta.has-hover ? Theme.fg : Theme.fg-muted;
                        }
                    }
                    hide-ta := TouchArea {
                        width: 24px;
                        clicked => { root.toggle-sidebar(); }
                        Image { x: 5px; y: (parent.height - 14px) / 2; width: 14px; height: 14px; source: @image-url("icons/chevrons-left.svg"); colorize: hide-ta.has-hover ? Theme.fg : Theme.fg-muted; }
                    }
                }
            }
            // Drop highlight on a sidebar row (drop-side-y: the row's top in the list's content,
            // set from Rust with drop-side-h when the row changes). An overlay over the list,
            // clipped to it, moved with its scroll; no input handling and no accessibility node.
            Rectangle {
                x: 0;
                y: side-list.y;
                width: side-list.width;
                height: side-list.height;
                clip: true;
                visible: root.drop-side-row >= 0;
                Rectangle {
                    x: 0;
                    y: side-list.content-y + root.drop-side-y;
                    width: parent.width;
                    height: root.drop-side-h;
                    background: Theme.selection;
                    border-width: 2px;
                    border-color: Theme.cursor;
                }
            }
        }
        // Drag the sidebar's right edge to resize it.
        Rectangle {
            visible: sidebar-visible;
            x: sidebar-width; y: root.top-h; width: 4px; height: parent.height - root.top-h;
            background: side-ta.has-hover || side-ta.pressed ? Theme.ring : Theme.border;
            side-ta := TouchArea {
                mouse-cursor: col-resize;
                moved => {
                    if (self.pressed) {
                        root.sidebar-width = max(120px, min(400px, root.sidebar-width + self.mouse-x - self.pressed-x));
                        root.settings-changed();
                    }
                }
            }
        }
        // The collapsed sidebar: a strip that brings it back.
        Rectangle {
            visible: !sidebar-visible;
            x: 0; y: root.top-h; width: 12px; height: parent.height - root.top-h;
            background: show-ta.has-hover ? Theme.muted : Theme.sidebar;
            Text { y: 6px; text: "\u{00bb}"; horizontal-alignment: center; }
            show-ta := TouchArea { clicked => { root.toggle-sidebar(); } }
        }
        // The two panes and the split line, right of the sidebar (dnd.rs Layout.left), narrowed by
        // the preview column when it shows (dnd.rs Layout.preview: its share of the space right of
        // the sidebar, plus 3 px, half its handle).
        panes := Rectangle {
            x: sidebar-visible ? sidebar-width + 4px : 12px; y: root.top-h;
            width: root.preview ? (parent.width - self.x) * (1 - root.preview-width) - 3px : parent.width - self.x;
            height: parent.height - root.top-h;
            left := Pane {
                x: 0; y: 0; height: parent.height;
                width: split ? parent.width * split-ratio - 3px : parent.width;
                rows: left-rows; grid: left-grid; medium: left-medium; grid-rows: left-grid-rows; strip-rows: left-strip-rows; path: left-path; status: left-status; tabs: left-tabs; crumbs: left-crumbs;
                entry-sticky: root.path-entry-sticky;
                toggle-sticky => { root.path-entry-sticky = !root.path-entry-sticky; root.settings-changed(); }
                drop-tab: root.drop-tab-pane == 0 ? root.drop-tab : -1;
                drop-crumb: root.drop-crumb-pane == 0 ? root.drop-crumb : -1;
                tab-clicked(i) => { root.tab-select(0, i); }
                tab-close(i) => { root.tab-close(0, i); }
                tab-move(f, t) => { root.tab-move(0, f, t); }
                strip-resized => { root.strip-resized(0); }
                crumb-clicked(i) => { root.crumb-clicked(0, i); }
                crumb-menu(i, x, y) => { root.crumb-menu(0, i, x, y); }
                history-menu(x, y) => { root.history-menu(0, x, y); }
                crumb-geometry(i, x, w) => { root.crumb-geometry(0, i, x, w); }
                active: !split || active-pane == 0;
                sort-col: left-sort-col; sort-asc: left-sort-asc;
                current-row <=> left-current-row;
                navigate(p) => { root.navigate(0, p); }
                select(op, i) => { root.select(0, op, i); }
                viewport-changed(y, h) => { root.viewport-changed(0, y, h); }
                grid-cols(n) => { root.grid-cols(0, n); }
                grid-cursor(c) => { root.grid-cursor(0, c); }
                command(c) => { root.command(0, c); }
                edit-commit(m, o, t) => { root.edit-commit(0, m, o, t); }
                context-menu(r, x, y, s) => { root.context-menu(0, r, x, y, s); }
                context-key(r, x, y, cy, h) => { root.context-key(0, r, x, y, cy, h); }
                row-gesture(r, w, c, s) => { root.row-gesture(0, r, w, c, s); }
                drag-dx: root.drag-dx;
                drag-dy: root.drag-dy;
                drop-here: root.drop-pane == 0;
                drop-row: root.drop-row;
                band-here: root.band-pane == 0;
                band-x: root.band-x; band-y: root.band-y; band-w: root.band-w; band-h: root.band-h;
                band-pointer(k, x, y, c, s) => { root.band-pointer(0, k, x, y, c, s); }
                open-row(i) => { root.open-row(0, i); }
                sort-by(c) => { root.sort-by(0, c); }
                go-up => { root.go-up(0); }
                back-button => { root.pane-back(0); }
                forward-button => { root.pane-forward(0); }
                history(f) => { root.pane-history(0, f); }
                show-type: root.show-type;
                col-type: root.left-col-type;
                col-size: root.left-col-size;
                col-modified: root.left-col-modified;
                col-drag(c, dx, ph) => { root.col-drag(0, c, dx, ph); }
                col-fit(c) => { root.col-fit(0, c); }
                thumbnails: root.thumbnails;
                focus-requested => { active-pane = 0; }
                filter-open <=> root.left-filter-open;
                filter-text <=> root.left-filter-text;
                filter-edited(t) => { root.filter-edited(0, t); }
                filter-apply(t) => { root.filter-apply(0, t); }
                filter-return(t) => { root.filter-return(0, t); }
                search-pressed => { root.search-pressed(0); }
                content-mode <=> root.left-content-mode;
                content-toggled(on) => { root.content-toggled(0, on); }
                filter-clear => { root.filter-clear(0); }
                toolbar: root.toolbar == 2;
                tools: root.left-tools;
                preview-on: root.preview;
                tool(c) => { root.toolbar-clicked(0, c); }
                tool-tip(t) => { root.toolbar-tip(0, t); }
            }
            right := Pane {
                visible: split;
                x: parent.width * split-ratio + 3px; y: 0; height: parent.height;
                width: split ? parent.width - self.x : 0px;
                rows: right-rows; grid: right-grid; medium: right-medium; grid-rows: right-grid-rows; strip-rows: right-strip-rows; path: right-path; status: right-status; tabs: right-tabs; crumbs: right-crumbs;
                entry-sticky: root.path-entry-sticky;
                toggle-sticky => { root.path-entry-sticky = !root.path-entry-sticky; root.settings-changed(); }
                drop-tab: root.drop-tab-pane == 1 ? root.drop-tab : -1;
                drop-crumb: root.drop-crumb-pane == 1 ? root.drop-crumb : -1;
                tab-clicked(i) => { root.tab-select(1, i); }
                tab-close(i) => { root.tab-close(1, i); }
                tab-move(f, t) => { root.tab-move(1, f, t); }
                strip-resized => { root.strip-resized(1); }
                crumb-clicked(i) => { root.crumb-clicked(1, i); }
                crumb-menu(i, x, y) => { root.crumb-menu(1, i, x, y); }
                history-menu(x, y) => { root.history-menu(1, x, y); }
                crumb-geometry(i, x, w) => { root.crumb-geometry(1, i, x, w); }
                active: split && active-pane == 1;
                sort-col: right-sort-col; sort-asc: right-sort-asc;
                current-row <=> right-current-row;
                navigate(p) => { root.navigate(1, p); }
                select(op, i) => { root.select(1, op, i); }
                viewport-changed(y, h) => { root.viewport-changed(1, y, h); }
                grid-cols(n) => { root.grid-cols(1, n); }
                grid-cursor(c) => { root.grid-cursor(1, c); }
                command(c) => { root.command(1, c); }
                edit-commit(m, o, t) => { root.edit-commit(1, m, o, t); }
                context-menu(r, x, y, s) => { root.context-menu(1, r, x, y, s); }
                context-key(r, x, y, cy, h) => { root.context-key(1, r, x, y, cy, h); }
                row-gesture(r, w, c, s) => { root.row-gesture(1, r, w, c, s); }
                drag-dx: root.drag-dx;
                drag-dy: root.drag-dy;
                drop-here: root.drop-pane == 1;
                drop-row: root.drop-row;
                band-here: root.band-pane == 1;
                band-x: root.band-x; band-y: root.band-y; band-w: root.band-w; band-h: root.band-h;
                band-pointer(k, x, y, c, s) => { root.band-pointer(1, k, x, y, c, s); }
                open-row(i) => { root.open-row(1, i); }
                sort-by(c) => { root.sort-by(1, c); }
                go-up => { root.go-up(1); }
                back-button => { root.pane-back(1); }
                forward-button => { root.pane-forward(1); }
                history(f) => { root.pane-history(1, f); }
                show-type: root.show-type;
                col-type: root.right-col-type;
                col-size: root.right-col-size;
                col-modified: root.right-col-modified;
                col-drag(c, dx, ph) => { root.col-drag(1, c, dx, ph); }
                col-fit(c) => { root.col-fit(1, c); }
                thumbnails: root.thumbnails;
                focus-requested => { active-pane = 1; }
                filter-open <=> root.right-filter-open;
                filter-text <=> root.right-filter-text;
                filter-edited(t) => { root.filter-edited(1, t); }
                filter-apply(t) => { root.filter-apply(1, t); }
                filter-return(t) => { root.filter-return(1, t); }
                search-pressed => { root.search-pressed(1); }
                content-mode <=> root.right-content-mode;
                content-toggled(on) => { root.content-toggled(1, on); }
                filter-clear => { root.filter-clear(1); }
                toolbar: root.toolbar == 2;
                tools: root.right-tools;
                preview-on: root.preview;
                tool(c) => { root.toolbar-clicked(1, c); }
                tool-tip(t) => { root.toolbar-tip(1, t); }
            }
            splitter := Rectangle {
                visible: split;
                x: parent.width * split-ratio - 3px; y: 0; width: 6px; height: parent.height;
                background: splitter-ta.has-hover || splitter-ta.pressed ? Theme.ring : Theme.border;
                splitter-ta := TouchArea {
                    mouse-cursor: col-resize;
                    moved => {
                        if (self.pressed) {
                            split-ratio = max(0.15, min(0.85, (splitter.x + self.mouse-x) / panes.width));
                            root.settings-changed();
                        }
                    }
                }
            }
        }
        // The preview column's handle, 6 px as the splitter; dragging it sets the column's share of
        // the space right of the sidebar (0.2 to 0.6, preview.rs `clamp_ratio`).
        preview-handle := Rectangle {
            visible: root.preview;
            x: panes.x + panes.width; y: root.top-h; width: 6px; height: parent.height - root.top-h;
            background: preview-ta.has-hover || preview-ta.pressed ? Theme.ring : Theme.border;
            preview-ta := TouchArea {
                mouse-cursor: col-resize;
                moved => {
                    if (self.pressed) {
                        // The handle sits at width - share * area - 3 px (area: right of the sidebar).
                        root.preview-width = max(0.2, min(0.6, (root.width - preview-handle.x - (self.mouse-x - self.pressed-x) - 3px) / (root.width - panes.x)));
                        root.settings-changed();
                    }
                }
            }
        }
        // Always there (its functions are the driver's and preview.rs's), shown with the setting.
        preview-col := Preview {
            visible: root.preview;
            x: preview-handle.x + 6px; y: root.top-h;
            width: max(0px, parent.width - self.x); height: parent.height - root.top-h;
            title: root.preview-title;
            message: root.preview-message;
            pages: root.preview-pages;
            content-h: root.preview-content-h;
            mode: root.preview-mode;
            blocks: root.preview-blocks;
            link(u) => { root.preview-link(u); }
            zoom: root.preview-zoom;
            zoom-step(s) => { return root.preview-zoom-step(s); }
            menu(k, x, y) => {
                root.preview-menu-block = k;
                root.preview-menu-x = x;
                root.preview-menu-y = y;
                preview-menu.show();
                root.preview-menu(k);
            }
            scrolled(top, h) => { root.preview-scrolled(top, h); }
            resized(w) => { root.preview-resized(w); }
        }
    }

    // The preview's "Copy text" menu (P11-M4): the block right-clicked and where (window px).
    private property <int> preview-menu-block;
    private property <length> preview-menu-x;
    private property <length> preview-menu-y;
    preview-menu := PopupWindow {
        x: min(root.preview-menu-x, root.width - 166px);
        y: min(root.preview-menu-y, root.height - 2 * 26px - 12px);
        width: 160px;
        height: 2 * 26px + 6px;
        Rectangle {
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 3px;
                MenuItem {
                    text: "Copy this block";
                    activated => {
                        preview-menu.close();
                        root.preview-copy(root.preview-menu-block);
                    }
                }
                MenuItem {
                    text: "Copy all";
                    activated => {
                        preview-menu.close();
                        root.preview-copy(-1);
                    }
                }
            }
        }
    }

    // The bookmark the menu is for: its index in the bookmark list and its sidebar row.
    private property <int> menu-index;
    private property <int> menu-row;
    private property <length> menu-x;
    private property <length> menu-y;
    // Right-click on a bookmark: TwinFM's own menu (a Slint popup, not the shell's; no modal loop).
    bookmark-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 160px;
        height: 4 * 26px + 6px;
        Rectangle {
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 3px;
                MenuItem {
                    text: "Rename bookmark";
                    activated => {
                        bookmark-menu.close();
                        root.side-edit = root.menu-row;
                    }
                }
                MenuItem {
                    text: "Move up";
                    enabled: root.menu-index > 0;
                    activated => {
                        bookmark-menu.close();
                        root.bookmark-move(root.menu-index, true);
                    }
                }
                MenuItem {
                    text: "Move down";
                    enabled: root.menu-index + 1 < root.bookmark-count;
                    activated => {
                        bookmark-menu.close();
                        root.bookmark-move(root.menu-index, false);
                    }
                }
                MenuItem {
                    text: "Remove bookmark";
                    activated => {
                        bookmark-menu.close();
                        root.bookmark-remove(root.menu-index);
                    }
                }
            }
        }
    }

    // The breadcrumb dropdown: the subfolders of the crumb whose chevron was clicked. A popup, so
    // its rows exist only while it is open; a click picks, Escape or a click outside closes it.
    crumb-menu := PopupWindow {
        x: max(0px, min(root.crumb-menu-x, root.width - 280px));
        y: root.crumb-menu-y;
        width: 280px;
        height: max(30px, min(root.height - root.crumb-menu-y - 8px,
            root.crumb-menu-items.length * 22px + (root.crumb-menu-note == "" ? 0px : 22px) + 8px));
        Rectangle {
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;
            crumb-keys := FocusScope {
                property <int> focus-token: root.crumb-focus-token;
                changed focus-token => { self.focus(); }
                key-pressed(e) => {
                    if (e.text == Key.Escape) {
                        crumb-menu.close();
                        root.focus-pane(root.active-pane);
                        return accept;
                    }
                    let n = root.crumb-menu-items.length;
                    if (n > 0 && (e.text == Key.DownArrow || e.text == Key.UpArrow)) {
                        root.crumb-hl = e.text == Key.DownArrow ? min(n - 1, root.crumb-hl + 1) : max(0, root.crumb-hl - 1);
                        // Keep the highlighted row in view (22 px rows).
                        if (crumb-list.content-y + root.crumb-hl * 22px < 0px) {
                            crumb-list.content-y = -root.crumb-hl * 22px;
                        }
                        if (crumb-list.content-y + (root.crumb-hl + 1) * 22px > crumb-list.visible-height) {
                            crumb-list.content-y = crumb-list.visible-height - (root.crumb-hl + 1) * 22px;
                        }
                        return accept;
                    }
                    if (e.text == Key.Return && root.crumb-hl >= 0 && root.crumb-hl < n) {
                        crumb-menu.close();
                        root.crumb-pick(root.crumb-hl);
                        return accept;
                    }
                    return reject;
                }
            }
            VerticalLayout {
                padding: 4px;
                crumb-list := ListView {
                    accessible-label: "Folders";
                    for name[i] in root.crumb-menu-items: Rectangle {
                        height: 22px;
                        accessible-role: list-item;
                        accessible-label: name;
                        accessible-item-selected: i == root.crumb-hl;
                        background: i == root.crumb-hl ? Theme.selection : pick-ta.has-hover ? Theme.muted : transparent;
                        Text { x: 8px; width: parent.width - 12px; text: name; vertical-alignment: center; overflow: elide; }
                        pick-ta := TouchArea {
                            clicked => {
                                crumb-menu.close();
                                root.crumb-pick(i);
                            }
                        }
                    }
                }
                if root.crumb-menu-note != "": Text {
                    height: 22px;
                    x: 8px;
                    text: root.crumb-menu-note;
                    vertical-alignment: center;
                    color: Theme.fg-muted;
                }
            }
        }
    }

    wm-popup := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        close-policy: PopupClosePolicy.no-auto-close;
        TouchArea {
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) { root.wm-dismissed(); }
            }
        }
        FocusScope {
            property <int> focus-token: root.wm-focus-token;
            changed focus-token => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.F10 && e.modifiers.shift) { root.wm-key("more"); return accept; }
                if (e.text == Key.Escape) { root.wm-key("escape"); return accept; }
                if (e.text == Key.DownArrow) { root.wm-key("down"); return accept; }
                if (e.text == Key.UpArrow) { root.wm-key("up"); return accept; }
                if (e.text == Key.Home) { root.wm-key("home"); return accept; }
                if (e.text == Key.End) { root.wm-key("end"); return accept; }
                if (e.text == Key.RightArrow) { root.wm-key("right"); return accept; }
                if (e.text == Key.LeftArrow) { root.wm-key("left"); return accept; }
                if (e.text == Key.Return || e.text == " ") { root.wm-key("return"); return accept; }
                // Every other key stays in the menu, as in Explorer's.
                return accept;
            }
        }
        Rectangle {
            x: root.wm-x;
            y: root.wm-y;
            width: 280px;
            height: root.wm-h;
            background: Theme.card;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000040;
            // A press on the menu's own padding is no press outside it.
            TouchArea {}
            if root.wm-tools.length > 0: HorizontalLayout {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: 44px;
                padding-left: 4px;
                padding-right: 4px;
                padding-top: 4px;
                padding-bottom: 4px;
                alignment: space-between;
                for t in root.wm-tools: MenuToolButton {
                    tool: t;
                    picked => { root.wm-picked(t.id); }
                }
            }
            if root.wm-tools.length > 0: Rectangle {
                x: 8px; y: 4px + 44px + 4px; width: parent.width - 16px; height: 1px;
                background: Theme.border;
            }
            Flickable {
                x: 4px;
                y: root.wm-tools.length > 0 ? 4px + 44px + 9px : 4px;
                width: parent.width - 8px;
                height: parent.height - self.y - 4px;
                content-height: root.wm-list-h;
                content-y <=> root.wm-scroll;
                for e[i] in root.wm-items: MenuRow {
                    x: 0;
                    y: e.y;
                    width: parent.width;
                    entry: e;
                    hl: i == root.wm-hl;
                    picked => { root.wm-picked(e.id); }
                    hovered => { root.wm-hover(e.id, false); }
                }
            }
        }
        if root.wm-sub-shown: Rectangle {
            x: root.wm-sub-x;
            y: root.wm-sub-y;
            width: 250px;
            height: root.wm-sub-h;
            background: Theme.card;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000040;
            TouchArea {}
            Flickable {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                content-height: root.wm-sub-list-h;
                content-y <=> root.wm-sub-scroll;
                for e[i] in root.wm-sub-items: MenuRow {
                    x: 0;
                    y: e.y;
                    width: parent.width;
                    entry: e;
                    hl: i == root.wm-sub-hl;
                    picked => { root.wm-picked(e.id); }
                    hovered => { root.wm-hover(e.id, true); }
                }
            }
        }
    }

    // Ctrl+, or "Settings": what is otherwise chosen only by using the app or editing config.toml.
    // Labels left, controls right, OK and Cancel bottom right. Closes only through OK, Cancel or
    // Escape (no-auto-close), so a click on a control never closes it and Rust always hears how it
    // closed. The FocusScope takes Escape while a control inside has the focus.
    settings-dialog := PopupWindow {
        x: (root.width - 480px) / 2;
        y: max(10px, (root.height - 550px) / 2);
        width: 480px;
        height: 550px;
        close-policy: PopupClosePolicy.no-auto-close;
        Rectangle {
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-lg;
            // Showing a popup takes the focus from the window and gives it to nothing
            // (WindowInner::show_popup), and a focus() in init runs before that. Once the popup is
            // shown, show-settings bumps the token and the first field takes the focus, so typing,
            // Tab and Escape go to the dialog.
            property <int> focus-token: root.settings-focus-token;
            changed focus-token => { start-left-edit.focus(); }
            FocusScope {
                key-pressed(e) => {
                    if (e.text == Key.Escape) { root.settings-cancel(); return accept; }
                    return reject;
                }
                VerticalLayout {
                    padding: 18px;
                    spacing: 8px;
                    Text { text: "Settings"; font-size: 16px; font-weight: 600; accessible-role: text; }
                    GridLayout {
                        spacing: 8px;
                        Row {
                            Text { text: "Left start folder"; vertical-alignment: center; }
                            start-left-edit := Field {
                                text: root.dlg-start-left;
                                placeholder-text: "C:\\";
                                label: "Left start folder";
                                edited(t) => { root.settings-stage("start_left", t); }
                            }
                        }
                        Row {
                            Text { text: "Right start folder"; vertical-alignment: center; }
                            Field {
                                text: root.dlg-start-right;
                                placeholder-text: "The left pane's folder";
                                label: "Right start folder";
                                edited(t) => { root.settings-stage("start_right", t); }
                            }
                        }
                        Row {
                            Text { text: "Hidden files"; vertical-alignment: center; }
                            HorizontalLayout {
                                spacing: 12px;
                                Switch {
                                    text: "Left pane";
                                    checked: root.dlg-hidden-left;
                                    accessible-label: "Show hidden files in the left pane";
                                    toggled => { root.settings-stage("hidden_left", self.checked ? "true" : "false"); }
                                }
                                Switch {
                                    text: "Right pane";
                                    checked: root.dlg-hidden-right;
                                    accessible-label: "Show hidden files in the right pane";
                                    toggled => { root.settings-stage("hidden_right", self.checked ? "true" : "false"); }
                                }
                            }
                        }
                        Row {
                            Text { text: "Protected files"; vertical-alignment: center; }
                            HorizontalLayout {
                                spacing: 12px;
                                Switch {
                                    text: "Left pane";
                                    checked: root.dlg-protected-left;
                                    accessible-label: "Show protected operating system files in the left pane";
                                    toggled => { root.settings-stage("protected_left", self.checked ? "true" : "false"); }
                                }
                                Switch {
                                    text: "Right pane";
                                    checked: root.dlg-protected-right;
                                    accessible-label: "Show protected operating system files in the right pane";
                                    toggled => { root.settings-stage("protected_right", self.checked ? "true" : "false"); }
                                }
                            }
                        }
                        Row {
                            Text { text: "View"; vertical-alignment: center; }
                            HorizontalLayout {
                                spacing: 12px;
                                Choice {
                                    model: ["Left: details", "Left: large icons", "Left: medium icons"];
                                    current-index: root.dlg-view-left;
                                    label: "View in the left pane";
                                    selected => { root.settings-stage("view_left", self.current-index == 2 ? "medium" : self.current-index == 1 ? "large" : "details"); }
                                }
                                Choice {
                                    model: ["Right: details", "Right: large icons", "Right: medium icons"];
                                    current-index: root.dlg-view-right;
                                    label: "View in the right pane";
                                    selected => { root.settings-stage("view_right", self.current-index == 2 ? "medium" : self.current-index == 1 ? "large" : "details"); }
                                }
                            }
                        }
                        Row {
                            Text { text: "Theme"; vertical-alignment: center; }
                            Choice {
                                model: ["System", "Light", "Dark"];
                                current-index: root.dlg-theme;
                                label: "Theme";
                                selected => { root.settings-stage("theme", self.current-index == 1 ? "light" : self.current-index == 2 ? "dark" : "system"); }
                            }
                        }
                        Row {
                            Text { text: "Columns"; vertical-alignment: center; }
                            Switch {
                                text: "Type column";
                                checked: root.dlg-type-column;
                                accessible-label: "Show the Type column";
                                toggled => { root.settings-stage("type_column", self.checked ? "true" : "false"); }
                            }
                        }
                        Row {
                            Text { text: "Thumbnails"; vertical-alignment: center; }
                            Switch {
                                text: "Thumbnails (32 px rows)";
                                checked: root.dlg-thumbnails;
                                accessible-label: "Show thumbnails in 32 px rows";
                                toggled => { root.settings-stage("thumbnails", self.checked ? "true" : "false"); }
                            }
                        }
                        Row {
                            Text { text: "Sidebar"; vertical-alignment: center; }
                            Switch {
                                text: "Show the sidebar";
                                checked: root.dlg-sidebar;
                                accessible-label: "Show the sidebar";
                                toggled => { root.settings-stage("sidebar", self.checked ? "true" : "false"); }
                            }
                        }
                        Row {
                            Text { text: "Toolbar"; vertical-alignment: center; }
                            Choice {
                                model: ["None", "Across the top", "In each pane"];
                                current-index: root.dlg-toolbar;
                                label: "Toolbar";
                                selected => { root.settings-stage("toolbar", self.current-index == 0 ? "none" : self.current-index == 2 ? "pane" : "top"); }
                            }
                        }
                        Row {
                            Text { text: "Preview"; vertical-alignment: center; }
                            Switch {
                                text: "Preview pane (Alt+P)";
                                checked: root.dlg-preview;
                                accessible-label: "Show the preview pane";
                                toggled => { root.settings-stage("preview", self.checked ? "true" : "false"); }
                            }
                        }
                        Row {
                            Text { text: "Path bar"; vertical-alignment: center; }
                            Switch {
                                text: "Breadcrumbs (off: a text entry)";
                                checked: root.dlg-crumbs;
                                accessible-label: "Breadcrumbs in the path bar";
                                toggled => { root.settings-stage("path_bar", self.checked ? "crumb" : "entry"); }
                            }
                        }
                    }
                    Rectangle { }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Btn {
                            text: "Cancel";
                            clicked => { root.settings-cancel(); }
                        }
                        Btn {
                            text: "OK";
                            primary: true;
                            clicked => { root.settings-ok(); }
                        }
                    }
                    Text {
                        text: root.settings-note;
                        font-size: 11px;
                        overflow: elide;
                        color: Theme.fg-muted;
                    }
                }
            }
        }
    }

    // F1 or "About TwinFM": name, version, license, and Slint's attribution (the AboutSlint
    // widget), which the Slint Royalty-free license asks for (README, License).
    about := PopupWindow {
        x: (root.width - 460px) / 2;
        y: max(10px, (root.height - 380px) / 2);
        width: 460px;
        height: 380px;
        Rectangle {
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-lg;
            VerticalLayout {
                padding: 18px;
                spacing: 6px;
                Text { text: "TwinFM"; font-size: 20px; font-weight: 600; }
                Text { text: "Version " + root.version; }
                Text { text: "A dual-pane file manager for Windows 11."; wrap: word-wrap; }
                Text { text: "MIT License. Copyright (c) 2026 Jeremy Klinger."; wrap: word-wrap; }
                Text {
                    text: "Built with a modified Slint, used under the Slint Royalty-free Desktop, Mobile, and Web Applications License 2.0.";
                    wrap: word-wrap;
                    font-size: 11px;
                }
                AboutSlint { }
                HorizontalLayout {
                    alignment: end;
                    Btn {
                        text: "Close";
                        primary: true;
                        clicked => { about.close(); }
                    }
                }
            }
        }
    }
}
