import { Pane, Row, TabInfo, Crumb, StatusInfo } from "pane.slint";
import { Palette, ListView, AboutSlint, Button, LineEdit, CheckBox } from "std-widgets.slint";
export { Row, TabInfo, Crumb, StatusInfo }

// One sidebar row (sidebar.rs Row): kind 0 section header, 1 drive, 2 place, 3 bookmark; index is
// the bookmark's index in the bookmark list.
export struct SideItem {
    label: string,
    kind: int,
    index: int,
}

component SideRow inherits Rectangle {
    in property <SideItem> item;
    // The row's inline title editor is open ("Rename bookmark").
    in property <bool> editing;
    // clicked(middle): the left or the middle button released over the row.
    callback clicked(bool);
    // menu(x, y): the right button released over a bookmark, at window coordinates.
    callback menu(length, length);
    // renamed(title): Return in the editor. edit-cancelled(refocus): Escape (true) or focus loss.
    callback renamed(string);
    callback edit-cancelled(bool);
    height: item.kind == 0 ? 26px : (root.editing ? 30px : 24px);
    background: item.kind != 0 && ta.has-hover ? Palette.alternate-background.brighter(0.2) : transparent;
    accessible-role: list-item;
    accessible-label: item.label;
    HorizontalLayout {
        visible: !root.editing;
        padding-left: item.kind == 0 ? 8px : 16px;
        padding-right: 6px;
        Text {
            text: item.label;
            vertical-alignment: item.kind == 0 ? bottom : center;
            overflow: elide;
            font-weight: item.kind == 0 ? 600 : 400;
            font-size: item.kind == 0 ? 11px : 13px;
            color: item.kind == 0 ? Palette.foreground.transparentize(35%) : Palette.foreground;
        }
    }
    // Exists only while the row is being renamed; takes the focus with the title selected.
    if root.editing: LineEdit {
        x: 8px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.item.label;
        accessible-label: "Bookmark title";
        init => {
            self.focus();
            self.select-all();
        }
        accepted(t) => { root.renamed(t); }
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.edit-cancelled(true); return accept; }
            return reject;
        }
        changed has-focus => {
            if (!self.has-focus) { root.edit-cancelled(false); }
        }
    }
    ta := TouchArea {
        enabled: item.kind != 0 && !root.editing;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) { root.clicked(false); }
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.middle) { root.clicked(true); }
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.right && item.kind == 3) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// One item of TwinFM's own popup menus; a disabled item is dimmed and takes no clicks.
component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback activated();
    height: 26px;
    background: ta.has-hover && root.enabled ? Palette.alternate-background.brighter(0.2) : transparent;
    accessible-role: button;
    accessible-label: root.text;
    Text {
        x: 10px;
        text: root.text;
        vertical-alignment: center;
        color: root.enabled ? Palette.foreground : Palette.foreground.transparentize(55%);
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
}

export component App inherits Window {
    // "TwinFM - <folder>" for the active pane's active tab.
    title: "TwinFM - " + (split && active-pane == 1 ? right-title : left-title);
    icon: @image-url("icon.svg");
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 400px;
    min-height: 300px;

    in property <[Row]> left-rows;
    in property <[Row]> right-rows;
    in property <string> left-path;
    in property <string> right-path;
    in property <StatusInfo> left-status;
    in property <StatusInfo> right-status;
    in property <[TabInfo]> left-tabs;
    in property <[TabInfo]> right-tabs;
    in property <[Crumb]> left-crumbs;
    in property <[Crumb]> right-crumbs;
    // The path bars show the text entry for good instead of the breadcrumb (the toggle glyph).
    in-out property <bool> path-entry-sticky: false;
    // The window title's folder name for each pane (its active tab's).
    in property <string> left-title;
    in property <string> right-title;
    // The sidebar: its rows, shown or collapsed to a strip, and its width.
    in property <[SideItem]> side-items;
    in-out property <bool> sidebar-visible: true;
    in-out property <length> sidebar-width: 180px;
    // For the About dialog (CARGO_PKG_VERSION).
    in property <string> version;
    // The Type column in both panes (settings `show_type`; set at start and by the dialog).
    in property <bool> show-type: true;
    // Thumbnails and 32 px rows in both panes (settings `thumbnails`; set at start and by the dialog).
    in property <bool> thumbnails: false;
    in property <int> left-sort-col;
    in property <bool> left-sort-asc;
    in property <int> right-sort-col;
    in property <bool> right-sort-asc;
    in-out property <bool> split: false;
    in-out property <int> active-pane: 0;
    in-out property <float> split-ratio: 0.5;
    in-out property <int> left-current-row: -1;
    in-out property <int> right-current-row: -1;
    // A drag over the window would drop into pane `drop-pane` (-1: none), on row `drop-row` (-1:
    // the pane's folder). Set by the drop target (dnd.rs).
    in-out property <int> drop-pane: -1;
    in-out property <int> drop-row: -1;
    // A drag would drop on tab `drop-tab` of pane `drop-tab-pane` (-1: none), or on sidebar row
    // `drop-side-row` (-1: none), whose top in the sidebar list and height are drop-side-y and
    // drop-side-h. Set by the drop target through main.rs `drop_highlight`, on change only.
    in-out property <int> drop-tab-pane: -1;
    in-out property <int> drop-tab: -1;
    in-out property <int> drop-side-row: -1;
    in-out property <length> drop-side-y;
    in-out property <length> drop-side-h;
    // The drag threshold in logical px (SM_CXDRAG / SM_CYDRAG over the scale factor).
    in property <length> drag-dx: 4px;
    in property <length> drag-dy: 4px;

    callback navigate(int, string);
    callback open-row(int, int);
    callback sort-by(int, int);
    callback go-up(int);
    // pane-back(pane), pane-forward(pane): the mouse's Back or Forward button released over that
    // pane (not necessarily the active one): it becomes active and goes back or forward in its
    // active tab's history. pane-history(pane, forward): Alt+Left / Alt+Right in its list.
    callback pane-back(int);
    callback pane-forward(int);
    callback pane-history(int, bool);
    callback toggle-split();
    callback toggle-hidden(int);
    callback refresh(int);
    // select(pane, op, row): op 0 only this row, 1 toggle, 2 range from anchor, 3 all, 4 right-click, 5 clear (model::SelOp)
    callback select(int, int, int);
    // viewport-changed(pane, content-y, visible-height)
    callback viewport-changed(int, length, length);
    // command(pane, name): a file operation key in that pane's list (pane.slint FileList).
    callback command(int, string);
    // edit-commit(pane, mode, original, typed): the inline name editor's Return.
    callback edit-commit(int, int, string, string);
    // context-menu(pane, row, x, y, shift): right-click on a row (row >= 0) or below the last row
    // (-1), window-relative logical coordinates. context-key(pane, row, list x, list y, content-y,
    // visible-height): Shift+F10 or the Menu key.
    callback context-menu(int, int, length, length, bool);
    callback context-key(int, int, length, length, length, length);
    // row-gesture(pane, row, what, ctrl, shift): left press (0), release (1), drag past the
    // threshold (2) or double-click (3) on a row, or a middle (4) or Back (5) button release, or a
    // move past the threshold with the right button down (6, a right-button drag), or a Forward
    // button release (7); see pane.slint
    // FileListBase.
    callback row-gesture(int, int, int, bool, bool);
    // tab-select(pane, index), tab-close(pane, index): a click or middle-click in a tab strip.
    callback tab-select(int, int);
    callback tab-close(int, int);
    // tab-move(pane, from, to): a tab dragged within its strip.
    callback tab-move(int, int, int);
    // tab-key(pane, what): for the active pane, Ctrl+T "new", Ctrl+W "close", Ctrl+Tab "next",
    // Ctrl+Shift+Tab "prev", Ctrl+1..9 "1".."9", Ctrl+Shift+PageUp "moveleft",
    // Ctrl+Shift+PageDown "moveright".
    callback tab-key(int, string);
    // crumb-clicked(pane, index): a breadcrumb button.
    callback crumb-clicked(int, int);
    // crumb-menu(pane, index, x, y): the chevron after a crumb; Rust lists its subfolders on a
    // worker and shows the dropdown below (x, y). crumb-pick(i): item i of the dropdown.
    callback crumb-menu(int, int, length, length);
    callback crumb-pick(int);
    // side-clicked(row, middle): a sidebar row; the middle button opens it in a new tab.
    callback side-clicked(int, bool);
    // bookmark-add(): Ctrl+D. bookmark-remove(index): the bookmark menu's "Remove bookmark".
    // bookmark-rename(index, title): the row's editor, opened by "Rename bookmark" (an empty
    // title goes back to the folder's name). bookmark-move(index, up): "Move up" / "Move down".
    callback bookmark-add();
    callback bookmark-remove(int);
    callback bookmark-rename(int, string);
    callback bookmark-move(int, bool);
    // How many bookmarks there are (for the menu's move items), and the sidebar row whose title
    // editor is open (-1: none).
    in property <int> bookmark-count;
    in-out property <int> side-edit: -1;
    // The name filter in each pane (pane.slint): whether its box shows and its text, set from Rust
    // on a tab switch and a navigation. filter-edited(pane, text): an edit (applied 150 ms after the
    // last one); filter-apply(pane, text): Return or Down in the box (at once; with a search waiting
    // for its pattern, the search starts); filter-clear(pane): Escape or the clear glyph.
    // search(pane): Ctrl+Shift+F, a recursive name search for the box's text in a new tab.
    in-out property <bool> left-filter-open;
    in-out property <string> left-filter-text;
    in-out property <bool> right-filter-open;
    in-out property <string> right-filter-text;
    callback filter-edited(int, string);
    callback filter-apply(int, string);
    callback filter-clear(int);
    callback search(int);
    // Ctrl+F, and Rust when a search waits for its pattern: the pane's filter box, focused.
    public function open-filter(p: int) {
        if (p == 0) { left.open-filter(); } else { right.open-filter(); }
    }
    // sidebar-toggled(): F9 or a sidebar glyph changed sidebar-visible.
    callback sidebar-toggled();
    // settings-changed(): the split line, the sidebar width or the path bar mode moved; Rust
    // saves the settings 500 ms after the last call.
    callback settings-changed();

    public function toggle-sidebar() {
        sidebar-visible = !sidebar-visible;
        root.sidebar-toggled();
    }

    public function show-about() { about.show(); }
    public function close-about() { about.close(); }

    // The settings dialog. settings-requested(): Ctrl+, or "Settings" in the sidebar; Rust copies
    // the live values into the dlg-* properties and calls show-settings. The controls stage their
    // values there through settings-stage; settings-closed(ok) tells Rust to apply them (OK) or to
    // drop them (Cancel, Escape). Nothing is applied while the dialog is open.
    callback settings-requested();
    callback settings-closed(bool);
    in-out property <string> dlg-start-left;
    in-out property <string> dlg-start-right;
    in-out property <bool> dlg-hidden-left;
    in-out property <bool> dlg-hidden-right;
    in-out property <bool> dlg-type-column;
    in-out property <bool> dlg-thumbnails;
    in-out property <bool> dlg-sidebar;
    in-out property <bool> dlg-crumbs;
    // "Saved to <file>", or that a scripted run saves nothing.
    in property <string> settings-note;
    private property <bool> settings-shown: false;
    // Bumped after each show: the dialog then puts the focus in its first field (see there).
    private property <int> settings-focus-token: 0;
    public function show-settings() {
        settings-shown = true;
        settings-dialog.show();
        settings-focus-token += 1;
    }
    function finish-settings(ok: bool) {
        settings-dialog.close();
        settings-shown = false;
        root.settings-closed(ok);
        root.focus-pane(root.active-pane);
    }
    public function settings-ok() { finish-settings(true); }
    public function settings-cancel() { finish-settings(false); }
    // What each control calls when the user changes it (and the driver's `settings set`): field
    // start_left, start_right (a path), hidden_left, hidden_right, type_column, thumbnails, sidebar
    // ("true" or "false"), path_bar ("entry" or "crumb").
    public function settings-stage(field: string, value: string) {
        if (field == "start_left") { dlg-start-left = value; }
        if (field == "start_right") { dlg-start-right = value; }
        if (field == "hidden_left") { dlg-hidden-left = value == "true"; }
        if (field == "hidden_right") { dlg-hidden-right = value == "true"; }
        if (field == "type_column") { dlg-type-column = value == "true"; }
        if (field == "thumbnails") { dlg-thumbnails = value == "true"; }
        if (field == "sidebar") { dlg-sidebar = value == "true"; }
        if (field == "path_bar") { dlg-crumbs = value != "entry"; }
    }

    // The breadcrumb dropdown's contents and place, set from Rust before show-crumb-menu.
    in property <[string]> crumb-menu-items;
    in property <string> crumb-menu-note;
    in property <length> crumb-menu-x;
    in property <length> crumb-menu-y;
    public function show-crumb-menu() { crumb-menu.show(); }
    public function close-crumb-menu() { crumb-menu.close(); }

    // Ctrl+L, and the driver's `pathmode`: the pane's path bar as text entry or breadcrumb.
    public function set-path-mode(p: int, entry: bool) {
        if (entry) {
            if (p == 0) { left.begin-path-entry(); } else { right.begin-path-entry(); }
        } else {
            if (p == 0) { left.end-path-entry(); } else { right.end-path-entry(); }
        }
    }

    public function focus-pane(p: int) {
        active-pane = p;
        if (p == 0) { left.focus-list(); } else { right.focus-list(); }
    }

    public function reset-scroll(p: int) {
        if (p == 0) { left.reset-scroll(); } else { right.reset-scroll(); }
    }

    // The pane's tab strip: scroll tab `i` into view (returns the strip's offset), and its tab
    // width and offset now (for the driver's tab drag).
    public function reveal-tab(p: int, i: int) -> length {
        return p == 0 ? left.reveal-tab(i) : right.reveal-tab(i);
    }
    public function tab-width(p: int) -> length { return p == 0 ? left.tab-w : right.tab-w; }
    public function tab-offset(p: int) -> length { return p == 0 ? left.shown-tab-scroll : right.shown-tab-scroll; }

    // The sidebar list's scroll offset (zero or negative), for the drop target's hit test.
    public function side-scroll() -> length { return side-list.content-y; }

    public function get-scroll(p: int) -> length {
        return p == 0 ? left.get-scroll() : right.get-scroll();
    }

    public function set-scroll(p: int, y: length) {
        if (p == 0) { left.set-scroll(y); } else { right.set-scroll(y); }
    }

    public function begin-edit(p: int, mode: int, text: string) {
        if (p == 0) { left.begin-edit(mode, text); } else { right.begin-edit(mode, text); }
    }

    // set-strip(pane, image, first row, width, height, shown): the pane's icon strip.
    public function set-strip(p: int, img: image, first: int, w: length, h: length, shown: bool) {
        if (p == 0) { left.set-strip(img, first, w, h, shown); } else { right.set-strip(img, first, w, h, shown); }
    }

    forward-focus: outer;

    outer := FocusScope {
        key-pressed(e) => {
            // The list rejects Escape (it cancels queued jobs first); with the settings dialog
            // open it cancels the dialog, which closes on nothing else but OK and Cancel.
            if (e.text == Key.Escape && root.settings-shown) { root.settings-cancel(); return accept; }
            if (e.modifiers.control && !e.modifiers.shift && e.text == ",") {
                if (!root.settings-shown) { root.settings-requested(); }
                return accept;
            }
            if (e.text == Key.F3) { root.toggle-split(); return accept; }
            if (e.modifiers.control && (e.text == "h" || e.text == "H")) { root.toggle-hidden(active-pane); return accept; }
            if (e.text == Key.F5 || (e.modifiers.control && (e.text == "r" || e.text == "R"))) {
                root.refresh(active-pane);
                return accept;
            }
            if (e.text == Key.RightArrow && e.modifiers.control && e.modifiers.shift) {
                if (split) { root.focus-pane(1 - active-pane); }
                return accept;
            }
            if (e.modifiers.control && (e.text == Key.Tab || e.text == Key.Backtab)) {
                root.tab-key(active-pane, e.modifiers.shift || e.text == Key.Backtab ? "prev" : "next");
                return accept;
            }
            if (e.modifiers.control && e.modifiers.shift && (e.text == Key.PageUp || e.text == Key.PageDown)) {
                root.tab-key(active-pane, e.text == Key.PageUp ? "moveleft" : "moveright");
                return accept;
            }
            if (e.modifiers.control && !e.modifiers.shift && (e.text == "t" || e.text == "T")) { root.tab-key(active-pane, "new"); return accept; }
            if (e.modifiers.control && !e.modifiers.shift && (e.text == "w" || e.text == "W")) { root.tab-key(active-pane, "close"); return accept; }
            if (e.modifiers.control && !e.modifiers.shift && (e.text == "1" || e.text == "2" || e.text == "3" || e.text == "4" || e.text == "5" || e.text == "6" || e.text == "7" || e.text == "8" || e.text == "9")) {
                root.tab-key(active-pane, e.text);
                return accept;
            }
            if (e.modifiers.control && (e.text == "l" || e.text == "L")) { root.set-path-mode(active-pane, true); return accept; }
            if (e.modifiers.control && (e.text == "f" || e.text == "F")) {
                if (e.modifiers.shift) { root.search(active-pane); } else { root.open-filter(active-pane); }
                return accept;
            }
            if (e.text == Key.F9) { root.toggle-sidebar(); return accept; }
            if (e.text == Key.F1) { root.show-about(); return accept; }
            if (e.modifiers.control && !e.modifiers.shift && (e.text == "d" || e.text == "D")) { root.bookmark-add(); return accept; }
            return reject;
        }
        sidebar := Rectangle {
            visible: sidebar-visible;
            x: 0; y: 0; width: sidebar-width; height: parent.height;
            background: Palette.alternate-background;
            // The renderer draws the whole window every frame; cached as one texture, the sidebar
            // costs a blit while the panes scroll and is redrawn only when its own properties change.
            cache-rendering-hint: true;
            VerticalLayout {
                padding-top: 3px;
                side-list := ListView {
                    accessible-label: "Places";
                    for item[i] in root.side-items: SideRow {
                        item: item;
                        editing: i == root.side-edit;
                        clicked(middle) => { root.side-clicked(i, middle); }
                        menu(x, y) => {
                            root.menu-index = item.index;
                            root.menu-row = i;
                            root.menu-x = x;
                            root.menu-y = y;
                            bookmark-menu.show();
                        }
                        renamed(t) => {
                            root.side-edit = -1;
                            root.bookmark-rename(item.index, t);
                            root.focus-pane(root.active-pane);
                        }
                        edit-cancelled(refocus) => {
                            root.side-edit = -1;
                            if (refocus) { root.focus-pane(root.active-pane); }
                        }
                    }
                }
                HorizontalLayout {
                    height: 26px;
                    padding-left: 8px;
                    padding-right: 4px;
                    spacing: 10px;
                    settings-ta := TouchArea {
                        width: 48px;
                        clicked => { if (!root.settings-shown) { root.settings-requested(); } }
                        Text {
                            text: "Settings";
                            font-size: 11px;
                            vertical-alignment: center;
                            color: settings-ta.has-hover ? Palette.accent-background : Palette.foreground;
                        }
                    }
                    about-ta := TouchArea {
                        clicked => { root.show-about(); }
                        Text {
                            text: "About TwinFM";
                            font-size: 11px;
                            vertical-alignment: center;
                            color: about-ta.has-hover ? Palette.accent-background : Palette.foreground;
                        }
                    }
                    hide-ta := TouchArea {
                        width: 24px;
                        clicked => { root.toggle-sidebar(); }
                        Text {
                            text: "\u{00ab}";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            color: hide-ta.has-hover ? Palette.accent-background : Palette.foreground;
                        }
                    }
                }
            }
            // Drop highlight on a sidebar row (drop-side-y: the row's top in the list's content,
            // set from Rust with drop-side-h when the row changes). An overlay over the list,
            // clipped to it, moved with its scroll; no input handling and no accessibility node.
            Rectangle {
                x: 0;
                y: side-list.y;
                width: side-list.width;
                height: side-list.height;
                clip: true;
                visible: root.drop-side-row >= 0;
                Rectangle {
                    x: 0;
                    y: side-list.content-y + root.drop-side-y;
                    width: parent.width;
                    height: root.drop-side-h;
                    background: Palette.accent-background.transparentize(65%);
                    border-width: 2px;
                    border-color: Palette.accent-background;
                }
            }
        }
        // Drag the sidebar's right edge to resize it.
        Rectangle {
            visible: sidebar-visible;
            x: sidebar-width; y: 0; width: 4px; height: parent.height;
            background: side-ta.has-hover || side-ta.pressed ? Palette.accent-background : Palette.border;
            side-ta := TouchArea {
                mouse-cursor: col-resize;
                moved => {
                    if (self.pressed) {
                        root.sidebar-width = max(120px, min(400px, root.sidebar-width + self.mouse-x - self.pressed-x));
                        root.settings-changed();
                    }
                }
            }
        }
        // The collapsed sidebar: a strip that brings it back.
        Rectangle {
            visible: !sidebar-visible;
            x: 0; y: 0; width: 12px; height: parent.height;
            background: show-ta.has-hover ? Palette.alternate-background.brighter(0.2) : Palette.alternate-background;
            Text { y: 6px; text: "\u{00bb}"; horizontal-alignment: center; }
            show-ta := TouchArea { clicked => { root.toggle-sidebar(); } }
        }
        // The two panes and the split line, right of the sidebar (dnd.rs Layout.left).
        panes := Rectangle {
            x: sidebar-visible ? sidebar-width + 4px : 12px; y: 0;
            width: parent.width - self.x; height: parent.height;
            left := Pane {
                x: 0; y: 0; height: parent.height;
                width: split ? parent.width * split-ratio - 3px : parent.width;
                rows: left-rows; path: left-path; status: left-status; tabs: left-tabs; crumbs: left-crumbs;
                entry-sticky: root.path-entry-sticky;
                toggle-sticky => { root.path-entry-sticky = !root.path-entry-sticky; root.settings-changed(); }
                drop-tab: root.drop-tab-pane == 0 ? root.drop-tab : -1;
                tab-clicked(i) => { root.tab-select(0, i); }
                tab-close(i) => { root.tab-close(0, i); }
                tab-move(f, t) => { root.tab-move(0, f, t); }
                crumb-clicked(i) => { root.crumb-clicked(0, i); }
                crumb-menu(i, x, y) => { root.crumb-menu(0, i, x, y); }
                active: !split || active-pane == 0;
                sort-col: left-sort-col; sort-asc: left-sort-asc;
                current-row <=> left-current-row;
                navigate(p) => { root.navigate(0, p); }
                select(op, i) => { root.select(0, op, i); }
                viewport-changed(y, h) => { root.viewport-changed(0, y, h); }
                command(c) => { root.command(0, c); }
                edit-commit(m, o, t) => { root.edit-commit(0, m, o, t); }
                context-menu(r, x, y, s) => { root.context-menu(0, r, x, y, s); }
                context-key(r, x, y, cy, h) => { root.context-key(0, r, x, y, cy, h); }
                row-gesture(r, w, c, s) => { root.row-gesture(0, r, w, c, s); }
                drag-dx: root.drag-dx;
                drag-dy: root.drag-dy;
                drop-here: root.drop-pane == 0;
                drop-row: root.drop-row;
                open-row(i) => { root.open-row(0, i); }
                sort-by(c) => { root.sort-by(0, c); }
                go-up => { root.go-up(0); }
                back-button => { root.pane-back(0); }
                forward-button => { root.pane-forward(0); }
                history(f) => { root.pane-history(0, f); }
                show-type: root.show-type;
                thumbnails: root.thumbnails;
                focus-requested => { active-pane = 0; }
                filter-open <=> root.left-filter-open;
                filter-text <=> root.left-filter-text;
                filter-edited(t) => { root.filter-edited(0, t); }
                filter-apply(t) => { root.filter-apply(0, t); }
                filter-clear => { root.filter-clear(0); }
            }
            right := Pane {
                visible: split;
                x: parent.width * split-ratio + 3px; y: 0; height: parent.height;
                width: split ? parent.width - self.x : 0px;
                rows: right-rows; path: right-path; status: right-status; tabs: right-tabs; crumbs: right-crumbs;
                entry-sticky: root.path-entry-sticky;
                toggle-sticky => { root.path-entry-sticky = !root.path-entry-sticky; root.settings-changed(); }
                drop-tab: root.drop-tab-pane == 1 ? root.drop-tab : -1;
                tab-clicked(i) => { root.tab-select(1, i); }
                tab-close(i) => { root.tab-close(1, i); }
                tab-move(f, t) => { root.tab-move(1, f, t); }
                crumb-clicked(i) => { root.crumb-clicked(1, i); }
                crumb-menu(i, x, y) => { root.crumb-menu(1, i, x, y); }
                active: split && active-pane == 1;
                sort-col: right-sort-col; sort-asc: right-sort-asc;
                current-row <=> right-current-row;
                navigate(p) => { root.navigate(1, p); }
                select(op, i) => { root.select(1, op, i); }
                viewport-changed(y, h) => { root.viewport-changed(1, y, h); }
                command(c) => { root.command(1, c); }
                edit-commit(m, o, t) => { root.edit-commit(1, m, o, t); }
                context-menu(r, x, y, s) => { root.context-menu(1, r, x, y, s); }
                context-key(r, x, y, cy, h) => { root.context-key(1, r, x, y, cy, h); }
                row-gesture(r, w, c, s) => { root.row-gesture(1, r, w, c, s); }
                drag-dx: root.drag-dx;
                drag-dy: root.drag-dy;
                drop-here: root.drop-pane == 1;
                drop-row: root.drop-row;
                open-row(i) => { root.open-row(1, i); }
                sort-by(c) => { root.sort-by(1, c); }
                go-up => { root.go-up(1); }
                back-button => { root.pane-back(1); }
                forward-button => { root.pane-forward(1); }
                history(f) => { root.pane-history(1, f); }
                show-type: root.show-type;
                thumbnails: root.thumbnails;
                focus-requested => { active-pane = 1; }
                filter-open <=> root.right-filter-open;
                filter-text <=> root.right-filter-text;
                filter-edited(t) => { root.filter-edited(1, t); }
                filter-apply(t) => { root.filter-apply(1, t); }
                filter-clear => { root.filter-clear(1); }
            }
            splitter := Rectangle {
                visible: split;
                x: parent.width * split-ratio - 3px; y: 0; width: 6px; height: parent.height;
                background: splitter-ta.has-hover || splitter-ta.pressed ? Palette.accent-background : Palette.border;
                splitter-ta := TouchArea {
                    mouse-cursor: col-resize;
                    moved => {
                        if (self.pressed) {
                            split-ratio = max(0.15, min(0.85, (splitter.x + self.mouse-x) / panes.width));
                            root.settings-changed();
                        }
                    }
                }
            }
        }
    }

    // The bookmark the menu is for: its index in the bookmark list and its sidebar row.
    private property <int> menu-index;
    private property <int> menu-row;
    private property <length> menu-x;
    private property <length> menu-y;
    // Right-click on a bookmark: TwinFM's own menu (a Slint popup, not the shell's; no modal loop).
    bookmark-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 160px;
        height: 4 * 26px + 6px;
        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                padding: 3px;
                MenuItem {
                    text: "Rename bookmark";
                    activated => {
                        bookmark-menu.close();
                        root.side-edit = root.menu-row;
                    }
                }
                MenuItem {
                    text: "Move up";
                    enabled: root.menu-index > 0;
                    activated => {
                        bookmark-menu.close();
                        root.bookmark-move(root.menu-index, true);
                    }
                }
                MenuItem {
                    text: "Move down";
                    enabled: root.menu-index + 1 < root.bookmark-count;
                    activated => {
                        bookmark-menu.close();
                        root.bookmark-move(root.menu-index, false);
                    }
                }
                MenuItem {
                    text: "Remove bookmark";
                    activated => {
                        bookmark-menu.close();
                        root.bookmark-remove(root.menu-index);
                    }
                }
            }
        }
    }

    // The breadcrumb dropdown: the subfolders of the crumb whose chevron was clicked. A popup, so
    // its rows exist only while it is open; a click picks, Escape or a click outside closes it.
    crumb-menu := PopupWindow {
        x: max(0px, min(root.crumb-menu-x, root.width - 280px));
        y: root.crumb-menu-y;
        width: 280px;
        height: max(30px, min(root.height - root.crumb-menu-y - 8px,
            root.crumb-menu-items.length * 22px + (root.crumb-menu-note == "" ? 0px : 22px) + 8px));
        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            crumb-keys := FocusScope {
                init => { self.focus(); }
                key-pressed(e) => {
                    if (e.text == Key.Escape) {
                        crumb-menu.close();
                        root.focus-pane(root.active-pane);
                        return accept;
                    }
                    return reject;
                }
            }
            VerticalLayout {
                padding: 4px;
                ListView {
                    accessible-label: "Folders";
                    for name[i] in root.crumb-menu-items: Rectangle {
                        height: 22px;
                        accessible-role: list-item;
                        accessible-label: name;
                        background: pick-ta.has-hover ? Palette.alternate-background.brighter(0.2) : transparent;
                        Text { x: 8px; width: parent.width - 12px; text: name; vertical-alignment: center; overflow: elide; }
                        pick-ta := TouchArea {
                            clicked => {
                                crumb-menu.close();
                                root.crumb-pick(i);
                            }
                        }
                    }
                }
                if root.crumb-menu-note != "": Text {
                    height: 22px;
                    x: 8px;
                    text: root.crumb-menu-note;
                    vertical-alignment: center;
                    color: Palette.foreground.transparentize(35%);
                }
            }
        }
    }

    // Ctrl+, or "Settings": what is otherwise chosen only by using the app or editing config.toml.
    // Labels left, controls right, OK and Cancel bottom right. Closes only through OK, Cancel or
    // Escape (no-auto-close), so a click on a control never closes it and Rust always hears how it
    // closed. The FocusScope takes Escape while a control inside has the focus.
    settings-dialog := PopupWindow {
        x: (root.width - 480px) / 2;
        y: max(10px, (root.height - 330px) / 2);
        width: 480px;
        height: 330px;
        close-policy: PopupClosePolicy.no-auto-close;
        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            // Showing a popup takes the focus from the window and gives it to nothing
            // (WindowInner::show_popup), and a focus() in init runs before that. Once the popup is
            // shown, show-settings bumps the token and the first field takes the focus, so typing,
            // Tab and Escape go to the dialog.
            property <int> focus-token: root.settings-focus-token;
            changed focus-token => { start-left-edit.focus(); }
            FocusScope {
                key-pressed(e) => {
                    if (e.text == Key.Escape) { root.settings-cancel(); return accept; }
                    return reject;
                }
                VerticalLayout {
                    padding: 18px;
                    spacing: 8px;
                    Text { text: "Settings"; font-size: 18px; font-weight: 700; accessible-role: text; }
                    GridLayout {
                        spacing: 6px;
                        Row {
                            Text { text: "Left start folder"; vertical-alignment: center; }
                            start-left-edit := LineEdit {
                                text: root.dlg-start-left;
                                placeholder-text: "C:\\";
                                accessible-label: "Left start folder";
                                edited(t) => { root.settings-stage("start_left", t); }
                            }
                        }
                        Row {
                            Text { text: "Right start folder"; vertical-alignment: center; }
                            LineEdit {
                                text: root.dlg-start-right;
                                placeholder-text: "The left pane's folder";
                                accessible-label: "Right start folder";
                                edited(t) => { root.settings-stage("start_right", t); }
                            }
                        }
                        Row {
                            Text { text: "Hidden files"; vertical-alignment: center; }
                            HorizontalLayout {
                                spacing: 12px;
                                CheckBox {
                                    text: "Left pane";
                                    checked: root.dlg-hidden-left;
                                    accessible-label: "Show hidden files in the left pane";
                                    toggled => { root.settings-stage("hidden_left", self.checked ? "true" : "false"); }
                                }
                                CheckBox {
                                    text: "Right pane";
                                    checked: root.dlg-hidden-right;
                                    accessible-label: "Show hidden files in the right pane";
                                    toggled => { root.settings-stage("hidden_right", self.checked ? "true" : "false"); }
                                }
                            }
                        }
                        Row {
                            Text { text: "Columns"; vertical-alignment: center; }
                            CheckBox {
                                text: "Type column";
                                checked: root.dlg-type-column;
                                accessible-label: "Show the Type column";
                                toggled => { root.settings-stage("type_column", self.checked ? "true" : "false"); }
                            }
                        }
                        Row {
                            Text { text: "Thumbnails"; vertical-alignment: center; }
                            CheckBox {
                                text: "Thumbnails (32 px rows)";
                                checked: root.dlg-thumbnails;
                                accessible-label: "Show thumbnails in 32 px rows";
                                toggled => { root.settings-stage("thumbnails", self.checked ? "true" : "false"); }
                            }
                        }
                        Row {
                            Text { text: "Sidebar"; vertical-alignment: center; }
                            CheckBox {
                                text: "Show the sidebar";
                                checked: root.dlg-sidebar;
                                accessible-label: "Show the sidebar";
                                toggled => { root.settings-stage("sidebar", self.checked ? "true" : "false"); }
                            }
                        }
                        Row {
                            Text { text: "Path bar"; vertical-alignment: center; }
                            CheckBox {
                                text: "Breadcrumbs (off: a text entry)";
                                checked: root.dlg-crumbs;
                                accessible-label: "Breadcrumbs in the path bar";
                                toggled => { root.settings-stage("path_bar", self.checked ? "crumb" : "entry"); }
                            }
                        }
                    }
                    Rectangle { }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Button {
                            text: "OK";
                            accessible-label: "OK";
                            clicked => { root.settings-ok(); }
                        }
                        Button {
                            text: "Cancel";
                            accessible-label: "Cancel";
                            clicked => { root.settings-cancel(); }
                        }
                    }
                    Text {
                        text: root.settings-note;
                        font-size: 11px;
                        overflow: elide;
                        color: Palette.foreground.transparentize(35%);
                    }
                }
            }
        }
    }

    // F1 or "About TwinFM": name, version, license, and Slint's attribution (the AboutSlint
    // widget), which the Slint Royalty-free license asks for (README, License).
    about := PopupWindow {
        x: (root.width - 460px) / 2;
        y: max(10px, (root.height - 380px) / 2);
        width: 460px;
        height: 380px;
        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            VerticalLayout {
                padding: 18px;
                spacing: 6px;
                Text { text: "TwinFM"; font-size: 22px; font-weight: 700; }
                Text { text: "Version " + root.version; }
                Text { text: "A dual-pane file manager for Windows 11."; wrap: word-wrap; }
                Text { text: "MIT License. Copyright (c) 2026 Jeremy Klinger."; wrap: word-wrap; }
                Text {
                    text: "Built with a modified Slint, used under the Slint Royalty-free Desktop, Mobile, and Web Applications License 2.0.";
                    wrap: word-wrap;
                    font-size: 11px;
                }
                AboutSlint { }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "Close";
                        clicked => { about.close(); }
                    }
                }
            }
        }
    }
}
