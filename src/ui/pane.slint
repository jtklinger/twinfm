component FileListNoType32 inherits FileRowsNoType32 {
    in property <int> focus-request;
    in property <bool> focus-on-init;
    callback key(KeyEvent) -> EventResult;
    forward-focus: key-area;
    init => {
        root.content-height = root.rows.length * 32px;
        if (root.focus-on-init) { key-area.focus(); }
    }
    changed focus-request => { key-area.focus(); }
    key-area := FocusScope {
        x: 0;
        width: 0;
        key-pressed(e) => { return root.key(e); }
    }
}

// The large-icon grid (P4-M1; the P3-M5 trace's variant b): the ListView's single `for` runs over
// GRID ROWS (120 px), each holding a nested `for` over its tiles (96 px wide). Tiles carry no
// image: the pane's strip draws the icons. Accessibility: each grid row is one list-item node (the
// item count is the grid-row count); the tiles add no role of their own, only their name Text.
component FileGrid inherits ListView {
    in property <[GridRow]> grid;
    in property <int> current-row: -1;
    in property <int> cols: 1;
    // row-pointer(entry, event, left button held, mouse x, mouse y, pressed x, pressed y, window x,
    // window y of the tile's TouchArea): FileListHost.row-pointer decides what it means.
    callback row-pointer(int, PointerEvent, bool, length, length, length, length, length, length);
    callback row-gesture(int, int, bool, bool);

    accessible-label: "Files";
    accessible-item-count: grid.length;
    accessible-delegate-focus: max(0, floor(current-row / max(1, cols)));

    for grow[r] in grid: Rectangle {
        height: 120px;
        accessible-role: AccessibleRole.list-item;
        accessible-item-index: r;
        for t[c] in grow.tiles: Rectangle {
            x: c * 96px;
            y: 0px;
            width: 96px;
            height: 120px;
            background: t.selected ? Palette.selection-background : transparent;
            border-width: t.current ? 1px : 0px;
            border-color: Palette.accent-background;
            // The icon (the strip's) fills 2..98 px; the name sits under it.
            Text {
                x: 2px;
                y: 99px;
                width: 92px;
                height: 19px;
                text: t.name;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                color: t.cut ? Palette.foreground.transparentize(55%) : Palette.foreground;
            }
            TouchArea {
                pointer-event(ev) => { root.row-pointer(grow.first + c, ev, self.pressed, self.mouse-x, self.mouse-y, self.pressed-x, self.pressed-y, self.absolute-position.x, self.absolute-position.y); }
                double-clicked => { root.row-gesture(grow.first + c, 3, false, false); }
            }
        }
    }
}

// The grid's focus layer, as FileList is FileRows'. init sets content-height to what the first
// layout will (120 px grid rows), so the Flickable does not scroll a new grid back to the top.
component FileGridList inherits FileGrid {
    in property <int> focus-request;
    in property <bool> focus-on-init;
    callback key(KeyEvent) -> EventResult;
    forward-focus: key-area;
    init => {
        root.content-height = root.grid.length * 120px;
        if (root.focus-on-init) { key-area.focus(); }
    }
    changed focus-request => { key-area.focus(); }
    key-area := FocusScope {
        x: 0;
        width: 0;
        key-pressed(e) => { return root.key(e); }
    }
}

// The medium-icon grid (P6-M2): FileGrid at icons::TileGeom::MEDIUM, 80 x 72 px tiles with the
// strip's 48 px icon at 16..64 x 2..50 and the name under it. A copy with its own constants rather
// than a tile size bound in the tile (the P3-M1 amendment): the large grid's generated tile stays
// the reference's, and FileListHost picks one of the two once per pane, outside the `for`.
component FileGridMedium inherits ListView {
    in property <[GridRow]> grid;
    in property <int> current-row: -1;
    in property <int> cols: 1;
    callback row-pointer(int, PointerEvent, bool, length, length, length, length, length, length);
    callback row-gesture(int, int, bool, bool);

    accessible-label: "Files";
    accessible-item-count: grid.length;
    accessible-delegate-focus: max(0, floor(current-row / max(1, cols)));

    for grow[r] in grid: Rectangle {
        height: 72px;
        accessible-role: AccessibleRole.list-item;
        accessible-item-index: r;
        for t[c] in grow.tiles: Rectangle {
            x: c * 80px;
            y: 0px;
            width: 80px;
            height: 72px;
            background: t.selected ? Palette.selection-background : transparent;
            border-width: t.current ? 1px : 0px;
            border-color: Palette.accent-background;
            Text {
                x: 2px;
                y: 51px;
                width: 76px;
                height: 19px;
                text: t.name;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                color: t.cut ? Palette.foreground.transparentize(55%) : Palette.foreground;
            }
            TouchArea {
                pointer-event(ev) => { root.row-pointer(grow.first + c, ev, self.pressed, self.mouse-x, self.mouse-y, self.pressed-x, self.pressed-y, self.absolute-position.x, self.absolute-position.y); }
                double-clicked => { root.row-gesture(grow.first + c, 3, false, false); }
            }
        }
    }
}

component FileGridMediumList inherits FileGridMedium {
    in property <int> focus-request;
    in property <bool> focus-on-init;
    callback key(KeyEvent) -> EventResult;
    forward-focus: key-area;
    init => {
        root.content-height = root.grid.length * 72px;
        if (root.focus-on-init) { key-area.focus(); }
    }
    changed focus-request => { key-area.focus(); }
    key-area := FocusScope {
        x: 0;
        width: 0;
        key-pressed(e) => { return root.key(e); }
    }
}

// A pane's file list: its state, callbacks and logic, and one of the six lists above, chosen by
// the Type column, thumbnail, view and tile size switches once per pane, outside any `for`. Switching keeps the rows, the scroll
// (content-y), the cursor and the selection, which are the host's; the new list binds to them.
// It has the ListView's geometry, so the pane's overlays (strip, drop highlight, empty space,
// rename editor) read list.x, list.y, list.visible-width, list.visible-height and list.content-y
// from it as before, and the row height from row-h. No accessible role: assistive clients see
// the inner list only.
component FileListHost inherits Rectangle {
    in property <[Row]> rows;
    in-out property <int> current-row: -1;
    in property <bool> show-type: true;
    // Thumbnails (settings `thumbnails`): the 32 px lists. row-h is the chosen list's row height
    // (a grid row's with the grid), for the host's and the pane's per-pane arithmetic only; no row
    // or tile reads it.
    in property <bool> thumbnails: false;
    // The large-icon grid (settings `view_left` / `view_right`, Ctrl+Shift+2): FileGridList over
    // grid-rows, `cols` tiles to a grid row from the width (at least 1), reported to Rust on change
    // while the grid shows (grid-cols: it re-maps the grid model; the width changes on split and
    // window resize only). The cursor moved (any path: keys, clicks, Rust): Rust marks the tile
    // (grid-cursor). line-of and col-of are an entry's grid row and column (in the details list,
    // its row and 0), for the overlays.
    in property <bool> grid: false;
    in property <[GridRow]> grid-rows;
    // Medium tiles (settings `tile_left` / `tile_right`, Ctrl+Shift+3): FileGridMediumList. tile-w
    // and tile-h are the tile's size (icons::TileGeom) for the host's and the pane's arithmetic.
    in property <bool> medium: false;
    out property <length> tile-w: root.medium ? 80px : 96px;
    out property <length> tile-h: root.medium ? 72px : 120px;
    out property <int> cols: max(1, floor(self.width / root.tile-w));
    callback grid-cols(int);
    callback grid-cursor(int);
    changed cols => { if (root.grid) { root.grid-cols(root.cols); } }
    changed current-row => { if (root.grid) { root.grid-cursor(root.current-row); } }
    pure public function line-of(i: int) -> int { return root.grid ? floor(i / root.cols) : i; }
    pure public function col-of(i: int) -> int { return root.grid ? mod(i, root.cols) : 0; }
    // Entries a vertical arrow key moves by: one row, or one grid row of tiles.
    private property <int> step: root.grid ? root.cols : 1;
    out property <length> row-h: root.grid ? root.tile-h : (root.thumbnails ? 32px : 22px);
    // The pane is active: a list created now takes the focus.
    in property <bool> active;
    in-out property <length> content-y;
    // A ListView's visible size is its own (Fluent's scrollbar overlays the content).
    out property <length> visible-width: self.width;
    out property <length> visible-height: self.height;
    callback open-row(int);
    callback focus-requested();
    // context-menu(row, x, y, shift): right button released over a row (row >= 0) or the empty
    // space below the last row (-1), at window-relative logical coordinates.
    callback context-menu(int, length, length, bool);
    // row-gesture(row, what, ctrl, shift), the left button on a row, decided in Rust (dnd::Gesture):
    // what 0 press, 1 release, 2 moved past the drag threshold with the button down (once per
    // press), 3 double-click; 4, the middle button released over the row; 5, the mouse's Back
    // button released over it; 6, moved past the threshold with the right button down (a
    // right-button drag, once per press); 7, the mouse's Forward button released over it.
    callback row-gesture(int, int, bool, bool);
    callback go-up();
    // history(forward): Alt+Left (back) or Alt+Right (forward) in the tab's history.
    callback history(bool);
    // op: 0 only this row, 1 toggle, 2 range from anchor, 3 all, 4 right-click, 5 clear (model::SelOp)
    callback select(int, int);
    // (content-y, visible-height) whenever the list scrolls, resizes or changes length; Rust
    // turns it into the visible row range and fetches icons for it.
    callback viewport-changed(length, length);
    // File operations on the active pane: copy, move, delete, sdelete, rename, newfolder, newfile,
    // cc, cx, cv.
    callback command(string);
    // context-key(row, list x, list y, content-y, visible-height): Shift+F10 or the Menu key, after
    // the cursor row was scrolled into view; Rust places the menu under the row.
    callback context-key(int, length, length, length, length);
    // The drag threshold (SM_CXDRAG / SM_CYDRAG in logical px), set from Rust.
    in property <length> drag-dx: 4px;
    in property <length> drag-dy: 4px;
    // The drag gesture for the current press has been reported.
    private property <bool> drag-sent: false;
    // The right button is down on a row (TouchArea.pressed is the left button's only), and where
    // it went down, in the row: a move past the threshold starts a right-button drag (6).
    private property <bool> right-down: false;
    private property <length> right-x;
    private property <length> right-y;
    private property <int> focus-request: 0;
    private property <int> row-count: root.rows.length;
    changed content-y => { root.viewport-changed(root.content-y, root.visible-height); }
    changed visible-height => { root.viewport-changed(root.content-y, root.visible-height); }
    changed row-count => { root.viewport-changed(root.content-y, root.visible-height); }
    // A ListView's minimum size.
    min-width: 50px;
    min-height: 50px;

    public function focus-list() { root.focus-request += 1; }

    // Same arithmetic as StandardListView's bring-into-view, for our row-h rows (the cursor's
    // grid row in the grid): scroll just far enough that the cursor row is fully inside the
    // viewport, then apply the selection gesture.
    public function bring-into-view() {
        if (root.current-row < 0) { return; }
        let g = root.line-of(root.current-row);
        if (root.content-y + g * root.row-h < 0px) {
            root.content-y = -g * root.row-h;
        }
        if (root.content-y + (g + 1) * root.row-h > root.visible-height) {
            root.content-y = root.visible-height - (g + 1) * root.row-h;
        }
    }

    function cursor-moved(shift: bool) {
        if (root.current-row < 0) { return; }
        root.bring-into-view();
        root.select(shift ? 2 : 0, root.current-row);
    }

    // A row's TouchArea event (FileRows.row-pointer). The selection a press makes (or defers to
    // the release, so a drag carries the whole selection) is Rust's decision: dnd::Gesture.
    function row-pointer(i: int, ev: PointerEvent, pressed: bool, mx: length, my: length, px: length, py: length, ax: length, ay: length) {
        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
            root.drag-sent = false;
            root.right-down = false;
            root.current-row = i;
            root.focus-list();
            root.focus-requested();
            root.row-gesture(i, 0, ev.modifiers.control, ev.modifiers.shift);
        }
        // The grab ended without a release (the end of a right-button drag, main.rs).
        if (ev.kind == PointerEventKind.cancel) {
            root.right-down = false;
        }
        if (ev.kind == PointerEventKind.move && pressed && !root.drag-sent
            && (abs(mx - px) > root.drag-dx || abs(my - py) > root.drag-dy)) {
            root.drag-sent = true;
            root.row-gesture(i, 2, false, false);
        }
        if (ev.kind == PointerEventKind.move && root.right-down && !root.drag-sent
            && (abs(mx - root.right-x) > root.drag-dx || abs(my - root.right-y) > root.drag-dy)) {
            root.drag-sent = true;
            root.row-gesture(i, 6, false, false);
        }
        if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
            root.row-gesture(i, 1, ev.modifiers.control, ev.modifiers.shift);
        }
        if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.middle) {
            root.row-gesture(i, 4, false, false);
        }
        if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.back) {
            root.row-gesture(i, 5, false, false);
        }
        if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.forward) {
            root.row-gesture(i, 7, false, false);
        }
        // Select on the press (so the row is drawn selected before the menu's modal loop
        // starts), open the shell menu on the release. Explorer's rule: an unselected row becomes
        // the only selection, a selected row keeps it.
        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
            root.right-down = true;
            root.right-x = mx;
            root.right-y = my;
            root.drag-sent = false;
            root.current-row = i;
            root.focus-list();
            root.focus-requested();
            root.select(4, i);
        }
        if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.right) {
            root.right-down = false;
            root.context-menu(i, ax + mx, ay + my, ev.modifiers.shift);
        }
    }

    // The list's keys (the variants' zero-width FocusScope hands them here).
    function key(e: KeyEvent) -> EventResult {
        if (e.text == Key.Backspace && !e.modifiers.control) { root.go-up(); return EventResult.accept; }
        if (e.text == Key.UpArrow && e.modifiers.alt) { root.go-up(); return EventResult.accept; }
        if (e.text == Key.LeftArrow && e.modifiers.alt) { root.history(false); return EventResult.accept; }
        if (e.text == Key.RightArrow && e.modifiers.alt) { root.history(true); return EventResult.accept; }
        // Alt+Return: the size of every folder in the listing (P3-M3).
        if (e.text == Key.Return && e.modifiers.alt) { root.command("sizeall"); return EventResult.accept; }
        if (e.text == Key.Return) { if (root.current-row >= 0) { root.open-row(root.current-row); } return EventResult.accept; }
        // The grid: Left and Right move one entry, Up and Down one grid row (step = cols entries;
        // Down from the last full grid row lands on the last entry), PageUp and PageDown a
        // viewport of grid rows. In the details list step is 1 and the rest is unchanged.
        if (e.text == Key.LeftArrow && root.grid) {
            if (root.current-row > 0) { root.current-row -= 1; } else if (root.rows.length > 0) { root.current-row = 0; }
            root.cursor-moved(e.modifiers.shift);
            return EventResult.accept;
        }
        if (e.text == Key.RightArrow && root.grid) {
            if (root.current-row + 1 < root.rows.length) { root.current-row += 1; }
            root.cursor-moved(e.modifiers.shift);
            return EventResult.accept;
        }
        if (e.text == Key.UpArrow) {
            if (root.current-row >= root.step) { root.current-row -= root.step; } else if (root.current-row < 0 && root.rows.length > 0) { root.current-row = 0; }
            root.cursor-moved(e.modifiers.shift);
            return EventResult.accept;
        }
        if (e.text == Key.DownArrow) {
            if (root.current-row < 0) { if (root.rows.length > 0) { root.current-row = 0; } }
            else if (root.current-row + root.step < root.rows.length) { root.current-row += root.step; }
            else if (root.grid && root.line-of(root.current-row) + 1 < root.grid-rows.length) { root.current-row = root.rows.length - 1; }
            root.cursor-moved(e.modifiers.shift);
            return EventResult.accept;
        }
        // PageUp and PageDown: a viewport of lines, rows or grid rows of tiles (the details list's
        // since P6-M2). Ctrl+Shift+PageUp / PageDown move the tab (app.slint), so they pass.
        if ((e.text == Key.PageUp || e.text == Key.PageDown) && !e.modifiers.control) {
            if (root.rows.length > 0) {
                let page = max(1, floor(root.visible-height / root.row-h)) * root.step;
                if (root.current-row < 0) { root.current-row = 0; }
                else if (e.text == Key.PageUp) { root.current-row = max(0, root.current-row - page); }
                else { root.current-row = min(root.rows.length - 1, root.current-row + page); }
                root.cursor-moved(e.modifiers.shift);
            }
            return EventResult.accept;
        }
        if (e.text == Key.Home) { if (root.rows.length > 0) { root.current-row = 0; root.cursor-moved(e.modifiers.shift); } return EventResult.accept; }
        if (e.text == Key.End) { if (root.rows.length > 0) { root.current-row = root.rows.length - 1; root.cursor-moved(e.modifiers.shift); } return EventResult.accept; }
        // File operations live here, not in the window's outer scope, so they only fire while
        // the list has focus: a Delete typed into the path bar or the rename box stays text.
        if (e.text == Key.F5 && e.modifiers.shift) { root.command("copy"); return EventResult.accept; }
        if (e.text == Key.F6 && e.modifiers.shift) { root.command("move"); return EventResult.accept; }
        if (e.text == Key.Delete) { root.command(e.modifiers.shift ? "sdelete" : "delete"); return EventResult.accept; }
        if (e.text == Key.F2) { root.command("rename"); return EventResult.accept; }
        if ((e.text == Key.F10 && e.modifiers.shift) || e.text == Key.Menu) {
            root.bring-into-view();
            root.context-key(root.current-row, root.absolute-position.x, root.absolute-position.y, root.content-y, root.visible-height);
            return EventResult.accept;
        }
        if (e.text == Key.F7 || (e.modifiers.control && e.modifiers.shift && (e.text == "n" || e.text == "N"))) {
            root.command("newfolder");
            return EventResult.accept;
        }
        // Ctrl+Alt+N: a new empty file (P6-M3), named in the editor as a new folder is.
        if (e.modifiers.control && e.modifiers.alt && !e.modifiers.shift && (e.text == "n" || e.text == "N")) {
            root.command("newfile");
            return EventResult.accept;
        }
        if (e.modifiers.control && !e.modifiers.shift && (e.text == "c" || e.text == "C")) { root.command("cc"); return EventResult.accept; }
        if (e.modifiers.control && !e.modifiers.shift && (e.text == "x" || e.text == "X")) { root.command("cx"); return EventResult.accept; }
        if (e.modifiers.control && !e.modifiers.shift && (e.text == "v" || e.text == "V")) { root.command("cv"); return EventResult.accept; }
        if (e.modifiers.control && !e.modifiers.shift && (e.text == "z" || e.text == "Z")) { root.command("undo"); return EventResult.accept; }
        // Escape stops a search, cancels queued jobs, or else clears the selection (main.rs). Reject
        // after it: the runtime closes the topmost popup (crumb menu, bookmark menu, About) on an
        // Escape the focused item did not take; accepting it here broke that (P2-M2).
        if (e.text == Key.Escape) { root.command("cancelqueued"); return EventResult.reject; }
        if (e.text == " ") { if (root.current-row >= 0) { root.select(1, root.current-row); } return EventResult.accept; }
        if (e.modifiers.control && (e.text == "a" || e.text == "A")) { root.select(3, root.current-row); return EventResult.accept; }
        return EventResult.reject;
    }

    if root.show-type && !root.thumbnails && !root.grid: FileList {
        width: root.width;
        height: root.height;
        rows: root.rows;
        current-row: root.current-row;
        content-y <=> root.content-y;
        focus-request: root.focus-request;
        focus-on-init: root.active;
        row-pointer(i, ev, p, mx, my, px, py, ax, ay) => { root.row-pointer(i, ev, p, mx, my, px, py, ax, ay); }
        row-gesture(r, w, c, s) => { root.row-gesture(r, w, c, s); }
        key(e) => { return root.key(e); }
    }
    if !root.show-type && !root.thumbnails && !root.grid: FileListNoType {
        width: root.width;
        height: root.height;
        rows: root.rows;
        current-row: root.current-row;
        content-y <=> root.content-y;
        focus-request: root.focus-request;
        focus-on-init: root.active;
        row-pointer(i, ev, p, mx, my, px, py, ax, ay) => { root.row-pointer(i, ev, p, mx, my, px, py, ax, ay); }
        row-gesture(r, w, c, s) => { root.row-gesture(r, w, c, s); }
        key(e) => { return root.key(e); }
    }
    if root.show-type && root.thumbnails && !root.grid: FileList32 {
        width: root.width;
        height: root.height;
        rows: root.rows;
        current-row: root.current-row;
        content-y <=> root.content-y;
        focus-request: root.focus-request;
        focus-on-init: root.active;
        row-pointer(i, ev, p, mx, my, px, py, ax, ay) => { root.row-pointer(i, ev, p, mx, my, px, py, ax, ay); }
        row-gesture(r, w, c, s) => { root.row-gesture(r, w, c, s); }
        key(e) => { return root.key(e); }
    }
    if !root.show-type && root.thumbnails && !root.grid: FileListNoType32 {
        width: root.width;
        height: root.height;
        rows: root.rows;
        current-row: root.current-row;
        content-y <=> root.content-y;
        focus-request: root.focus-request;
        focus-on-init: root.active;
        row-pointer(i, ev, p, mx, my, px, py, ax, ay) => { root.row-pointer(i, ev, p, mx, my, px, py, ax, ay); }
        row-gesture(r, w, c, s) => { root.row-gesture(r, w, c, s); }
        key(e) => { return root.key(e); }
    }
    if root.grid && !root.medium: FileGridList {
        width: root.width;
        height: root.height;
        grid: root.grid-rows;
        cols: root.cols;
        current-row: root.current-row;
        content-y <=> root.content-y;
        focus-request: root.focus-request;
        focus-on-init: root.active;
        row-pointer(i, ev, p, mx, my, px, py, ax, ay) => { root.row-pointer(i, ev, p, mx, my, px, py, ax, ay); }
        row-gesture(r, w, c, s) => { root.row-gesture(r, w, c, s); }
        key(e) => { return root.key(e); }
    }
    if root.grid && root.medium: FileGridMediumList {
        width: root.width;
        height: root.height;
        grid: root.grid-rows;
        cols: root.cols;
        current-row: root.current-row;
        content-y <=> root.content-y;
        focus-request: root.focus-request;
        focus-on-init: root.active;
        row-pointer(i, ev, p, mx, my, px, py, ax, ay) => { root.row-pointer(i, ev, p, mx, my, px, py, ax, ay); }
        row-gesture(r, w, c, s) => { root.row-gesture(r, w, c, s); }
        key(e) => { return root.key(e); }
    }
}

export component Pane inherits Rectangle {
    in property <[Row]> rows;
    // The folder the active tab shows (set from Rust on navigation and tab switch).
    in property <string> path;
    in property <StatusInfo> status;
    in property <[TabInfo]> tabs;
    in property <[Crumb]> crumbs;
    // The path bar shows the text entry instead of the breadcrumb: for now (Ctrl+L, until
    // Return, Escape or focus loss) or for good while entry-sticky (the toggle glyph).
    in-out property <bool> path-entry: false;
    in property <bool> entry-sticky: false;
    in property <bool> active;
    in property <int> sort-col: 0;
    in property <bool> sort-asc: true;
    in-out property <int> current-row: -1;
    // The Type column (settings `show_type`). Off, the pane shows a header and a list without the
    // Type cell (FileListHost), and the Name column takes the 120 px.
    in property <bool> show-type: true;
    // Thumbnails (settings `thumbnails`): the 32 px lists (FileListHost); the overlays below read
    // the row height from list.row-h.
    in property <bool> thumbnails: false;
    // The large-icon grid (settings `view_left` / `view_right`): FileListHost shows the grid over
    // grid-rows (model.rs GridModel); tiles-per-row is its tile count per grid row (main.rs reads it
    // for hit testing); the two callbacks are the host's.
    in property <bool> grid: false;
    in property <[GridRow]> grid-rows;
    // Medium tiles in the grid (FileListHost.medium).
    in property <bool> medium: false;
    out property <int> tiles-per-row: list.cols;
    // The toolbar inside the pane, above the path bar (settings `toolbar = "pane"`), its buttons'
    // state and tool(name) for a press (main.rs makes the pane active). A sibling of the
    // list, created only with the setting (dnd.rs PANE_BAR).
    in property <bool> toolbar: false;
    in property <ToolState> tools;
    callback tool(string);
    callback grid-cols(int);
    callback grid-cursor(int);
    // The rubber band (P4-M3, grid only): band-pointer(kind, window x, window y, ctrl, shift) for
    // the left button on empty grid space (kind 0 down, 1 move, 2 up, 3 cancel); main.rs runs the
    // gesture (band.rs) and draws it through band-here and the rectangle (content coordinates).
    callback band-pointer(int, length, length, bool, bool);
    in property <bool> band-here: false;
    in property <length> band-x;
    in property <length> band-y;
    in property <length> band-w;
    in property <length> band-h;
    function band-ev(ev: PointerEvent, ax: length, ay: length, mx: length, my: length) {
        if (!root.grid) { return; }
        if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
            list.focus-list();
            root.focus-requested();
            root.band-pointer(0, ax + mx, ay + my, ev.modifiers.control, ev.modifiers.shift);
        }
        if (ev.kind == PointerEventKind.move) { root.band-pointer(1, ax + mx, ay + my, false, false); }
        if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) { root.band-pointer(2, ax + mx, ay + my, false, false); }
        if (ev.kind == PointerEventKind.cancel) { root.band-pointer(3, ax + mx, ay + my, false, false); }
    }

    callback navigate(string);
    callback open-row(int);
    callback sort-by(int);
    callback go-up();
    callback focus-requested();
    callback tab-clicked(int);
    callback tab-close(int);
    // tab-move(from, to): a tab dragged past a neighbour's midpoint.
    callback tab-move(int, int);
    callback crumb-clicked(int);
    // crumb-menu(index, x, y): the chevron after crumb `index`, at window coordinates.
    callback crumb-menu(int, length, length);
    callback toggle-sticky();
    // The mouse's Back or Forward button released anywhere over the pane that is not a text entry,
    // the tab strip or the scrollbar: main.rs makes the pane active and goes back or forward in
    // its active tab's history.
    callback back-button();
    callback forward-button();
    // history(forward): Alt+Left / Alt+Right in the list.
    callback history(bool);
    callback select(int, int);
    callback viewport-changed(length, length);
    callback command(string);
    // edit-commit(mode, original name, typed name): mode 1 rename, 2 new folder, 3 new file.
    callback edit-commit(int, string, string);
    callback context-menu(int, length, length, bool);
    callback context-key(int, length, length, length, length);
    callback row-gesture(int, int, bool, bool);
    in property <length> drag-dx: 4px;
    in property <length> drag-dy: 4px;
    // A drag is over this pane and would drop: on row `drop-row`, or (-1) into the pane's folder.
    in property <bool> drop-here: false;
    in property <int> drop-row: -1;
    // A drag is over tab `drop-tab` of the strip and would drop into its folder (-1: none).
    in property <int> drop-tab: -1;
    // A drag is over crumb `drop-crumb` of the breadcrumb and would drop into its folder (-1: none).
    in property <int> drop-crumb: -1;
    // crumb-geometry(index, x, width): crumb `index`'s x in the crumb row and its label's width, or
    // with index -1 the crumb row's offset in the bar and the bar's width (the drop target's hit
    // test; never per frame).
    callback crumb-geometry(int, length, length);

    // The name filter (Ctrl+F): a box at the right end of the path bar, created only while
    // filter-open (an `if` here, never in a row). filter-text is the active tab's filter; main.rs
    // sets both on a tab switch and a navigation. filter-edited(text) on every edit (main.rs
    // applies it 150 ms after the last one); filter-apply(text) on Return or Down (at once, the
    // focus goes to the list); filter-clear() on Escape or the clear glyph (the box closes).
    in-out property <bool> filter-open: false;
    in-out property <string> filter-text;
    callback filter-edited(string);
    callback filter-apply(string);
    callback filter-clear();
    // Bumped by open-filter: the box takes the focus (when it already exists; a new one takes it
    // in its init while filter-grab is set). When Rust closes the box (a navigation, a tab switch,
    // a search starting) it gives the active pane's list the focus (main.rs `set_filter_box`).
    private property <int> filter-focus: 0;
    private property <bool> filter-grab: false;
    private property <length> filter-w: root.filter-open ? 220px : 0px;

    // Ctrl+F: show the box with the focus in it, its text selected.
    public function open-filter() {
        root.filter-grab = true;
        root.filter-open = true;
        root.filter-focus += 1;
    }

    function close-filter() {
        root.filter-text = "";
        root.filter-open = false;
        root.filter-clear();
        list.focus-list();
    }

    // The inline name editor: 0 closed, 1 renaming the cursor row, 2 naming a new folder, 3 a new
    // file.
    in-out property <int> edit-mode: 0;
    private property <string> edit-original;

    // The icon strip (`set-strip`): one image holding the icons of the rows from strip-top (the
    // first one's top in the list's content, row x row height, computed in Rust, so the per-frame
    // `y` binding reads no row height) onwards, composed in Rust, at strip-width x strip-height
    // logical px (its exact physical size), strip-left px into the list (6 px in the details list's
    // icon column, 0 in the grid).
    private property <image> strip;
    private property <length> strip-left;
    private property <length> strip-top;
    private property <length> strip-width;
    private property <length> strip-height;
    private property <bool> strip-shown: false;
    // The grid's icon strip: one image per grid row, in a ring of slots Rust fills for the grid
    // rows on screen and one each side (main.rs `grid_slots`), so a scroll of one grid row
    // recomposes and uploads one 120 px row, not the whole strip; a slot's image changes only
    // when its row does. Empty with the details list (the `for` makes nothing).
    in property <[StripRow]> strip-rows;

    // The tab strip: every tab the same width, from 160 px down to 120 px as tabs are added, then
    // the strip scrolls instead (no scrollbar; the wheel scrolls it). tab-scroll is the content's
    // offset (zero or negative), set by the wheel and by reveal-tab; shown-tab-scroll keeps it in
    // range when tabs close or the pane widens. All of these are bindings on the tab count and the
    // pane's width, so nothing here runs while the list scrolls.
    in-out property <length> tab-scroll: 0px;
    private property <length> tab-strip-w: root.width - 6px;
    out property <length> tab-w: max(120px, min(160px, root.tab-strip-w / max(1, root.tabs.length)));
    private property <length> tab-scroll-min: min(0px, root.tab-strip-w - root.tabs.length * root.tab-w);
    out property <length> shown-tab-scroll: max(root.tab-scroll-min, min(0px, root.tab-scroll));
    // The tab a left-button drag in the strip is moving (-1: none).
    private property <int> drag-tab: -1;
    // The strip's width changed (a window resize, the split or the splitter, the sidebar): main.rs
    // scrolls the active tab back into view (P6-M3). Only while the strip shows.
    callback strip-resized();
    changed tab-strip-w => { if (root.tabs.length > 1) { root.strip-resized(); } }

    border-width: active ? 2px : 1px;
    border-color: active ? Palette.accent-background : Palette.border;
    background: Palette.background;

    // Scroll the strip just far enough that tab `i` is fully in view; returns the new offset.
    // Called from Rust when the active tab or the tab count changes, never per frame.
    public function reveal-tab(i: int) -> length {
        // Before the window's first layout the pane has no width: nothing to reveal yet (main.rs
        // reveals again once the window exists).
        if (root.tab-strip-w <= 0px) {
            return root.shown-tab-scroll;
        }
        if (root.shown-tab-scroll + i * root.tab-w < 0px) {
            root.tab-scroll = -i * root.tab-w;
        } else if (root.shown-tab-scroll + (i + 1) * root.tab-w > root.tab-strip-w) {
            root.tab-scroll = root.tab-strip-w - (i + 1) * root.tab-w;
        } else {
            root.tab-scroll = root.shown-tab-scroll;
        }
        return root.shown-tab-scroll;
    }

    // No forward-focus: the list's FocusScope sits inside FileListHost's `if`, out of reach;
    // focus-list asks for it (nothing focuses a Pane itself).
    public function focus-list() { list.focus-list(); }
    public function reset-scroll() { list.content-y = 0; current-row = -1; }
    public function get-scroll() -> length { return list.content-y; }
    public function set-scroll(y: length) { list.content-y = y; }
    public function set-strip(img: image, left: length, top: length, w: length, h: length, shown: bool) {
        strip = img;
        strip-left = left;
        strip-top = top;
        strip-width = w;
        strip-height = h;
        strip-shown = shown;
    }

    // Open the name editor over the cursor row's name (rename) or the top row (new folder),
    // prefilled with `text` and all of it selected.
    public function begin-edit(mode: int, text: string) {
        if (mode == 1) { list.bring-into-view(); }
        root.edit-original = text;
        root.edit-mode = mode;
        edit.text = text;
        edit.focus();
        edit.select-all();
    }

    function end-edit() {
        root.edit-mode = 0;
        list.focus-list();
    }

    // Ctrl+L: the text entry, holding the current folder, all of it selected.
    public function begin-path-entry() {
        root.path-entry = true;
        path-edit.text = root.path;
        path-edit.focus();
        path-edit.select-all();
    }

    // Back to the breadcrumb (unless the entry is sticky), the entry showing the folder again.
    public function end-path-entry() {
        path-edit.text = root.path;
        root.path-entry = root.entry-sticky;
        list.focus-list();
    }

    changed path => { path-edit.text = root.path; }
    changed entry-sticky => { root.path-entry = root.entry-sticky; }

    // Behind everything in the pane: the Back and Forward buttons over the padding, the status
    // line and the gaps between the bar's buttons (every other TouchArea in the pane reports them
    // itself).
    TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.back) { root.back-button(); }
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.forward) { root.forward-button(); }
        }
    }

    VerticalLayout {
        padding: 3px;
        spacing: 2px;
        // Not a Flickable: its drag-to-flick would take the presses a tab drag needs.
        if root.tabs.length > 1: Rectangle {
            height: 26px;
            clip: true;
            // Behind the tabs, whose TouchAreas pass wheel events on: the wheel scrolls the strip.
            TouchArea {
                scroll-event(e) => {
                    root.tab-scroll = root.shown-tab-scroll + (abs(e.delta-y) > abs(e.delta-x) ? e.delta-y : e.delta-x);
                    root.tab-scroll = root.shown-tab-scroll;
                    return accept;
                }
            }
            for t[i] in root.tabs: TabButton {
                x: root.shown-tab-scroll + i * root.tab-w;
                y: 0px;
                width: root.tab-w;
                height: 26px;
                title: t.title;
                active: t.active;
                pressed => {
                    root.drag-tab = i;
                    root.tab-clicked(i);
                }
                released => { root.drag-tab = -1; }
                // The pointer's x in the strip's content is this tab's slot plus its offset in
                // the tab (whichever tab now sits in the slot). Once it passes a neighbour's
                // midpoint, the dragged tab swaps with that neighbour.
                drag-moved(mx) => {
                    if (root.drag-tab < 0) { return; }
                    if (i * root.tab-w + mx > (root.drag-tab + 1.5) * root.tab-w && root.drag-tab + 1 < root.tabs.length) {
                        root.tab-move(root.drag-tab, root.drag-tab + 1);
                        root.drag-tab += 1;
                    } else if (i * root.tab-w + mx < (root.drag-tab - 0.5) * root.tab-w && root.drag-tab > 0) {
                        root.tab-move(root.drag-tab, root.drag-tab - 1);
                        root.drag-tab -= 1;
                    }
                }
                close => { root.tab-close(i); }
            }
            // Drop highlight on tab `drop-tab` (a drag would drop into its folder): an overlay over
            // the tab's slot, no input handling and no accessibility node.
            if root.drop-tab >= 0: Rectangle {
                x: root.shown-tab-scroll + root.drop-tab * root.tab-w;
                y: 0px;
                width: root.tab-w;
                height: 26px;
                background: Palette.accent-background.transparentize(65%);
                border-width: 2px;
                border-color: Palette.accent-background;
            }
        }
        if root.toolbar: Toolbar {
            height: 28px;
            tools: root.tools;
            labelled: false;
            tool(c) => { root.tool(c); }
        }
        // Same height whichever mode shows, so the list's top does not move (dnd.rs LIST_TOP).
        Rectangle {
            height: 32px;
            // The text entry and the breadcrumb share the bar; one of the two shows.
            Rectangle {
                visible: root.path-entry;
                x: 0;
                width: parent.width - 26px - root.filter-w;
                // Behind the entry, which takes no side button: the mouse's Back or Forward button
                // over it is ignored, not taken by the pane as a move in the history (P6-M3).
                TouchArea { }
                path-edit := LineEdit {
                    width: 100%;
                    height: 100%;
                    accessible-label: "Path";
                    placeholder-text: "Path";
                    accepted(s) => {
                        root.navigate(s);
                        root.end-path-entry();
                    }
                    key-pressed(e) => {
                        if (e.text == Key.Escape) { root.end-path-entry(); return accept; }
                        return reject;
                    }
                    changed has-focus => {
                        if (!self.has-focus && root.path-entry && !root.entry-sticky) {
                            self.text = root.path;
                            root.path-entry = false;
                        }
                    }
                }
            }
            // The breadcrumb, right-aligned when it is wider than the bar, so the current folder
            // stays in view.
            crumb-clip := Rectangle {
                visible: !root.path-entry;
                x: 0;
                width: parent.width - 26px - root.filter-w;
                clip: true;
                changed width => { root.crumb-geometry(-1, crumb-row.x, self.width); }
                crumb-row := HorizontalLayout {
                    x: min(0px, parent.width - self.preferred-width);
                    width: self.preferred-width;
                    padding-top: 3px;
                    padding-bottom: 3px;
                    changed x => { root.crumb-geometry(-1, self.x, crumb-clip.width); }
                    for c[i] in root.crumbs: CrumbButton {
                        label: c.label;
                        drop-here: i == root.drop-crumb;
                        geometry(x, w) => { root.crumb-geometry(i, x, w); }
                        clicked => { root.crumb-clicked(i); }
                        menu(x, y) => { root.crumb-menu(i, x, y); }
                        back => { root.back-button(); }
                        forward => { root.forward-button(); }
                    }
                }
            }
            // The name filter's box and its clear glyph, left of the mode glyph.
            if root.filter-open: HorizontalLayout {
                x: parent.width - 26px - root.filter-w + 4px;
                width: root.filter-w - 4px;
                LineEdit {
                    accessible-label: "Filter";
                    placeholder-text: "Filter";
                    text <=> root.filter-text;
                    property <int> focus-token: root.filter-focus;
                    init => {
                        if (root.filter-grab) {
                            root.filter-grab = false;
                            self.focus();
                            self.select-all();
                        }
                    }
                    changed focus-token => {
                        root.filter-grab = false;
                        self.focus();
                        self.select-all();
                    }
                    edited(t) => { root.filter-edited(t); }
                    accepted(t) => {
                        root.filter-apply(t);
                        list.focus-list();
                    }
                    key-pressed(e) => {
                        if (e.text == Key.Escape) { root.close-filter(); return accept; }
                        // F7 makes no sense in the box: it does what it does in the list. The
                        // window's keys (Ctrl+W, Ctrl+T, Ctrl+Tab, F3, F5, F9) pass the box anyway;
                        // text keys (Ctrl+V, Ctrl+A, Ctrl+C, Ctrl+X, Delete, arrows) stay the box's.
                        if (e.text == Key.F7) {
                            list.focus-list();
                            root.command("newfolder");
                            return accept;
                        }
                        if (e.text == Key.DownArrow) {
                            root.filter-apply(self.text);
                            list.focus-list();
                            return accept;
                        }
                        return reject;
                    }
                }
                Rectangle {
                    width: 20px;
                    background: clear-ta.has-hover ? Palette.alternate-background.brighter(0.2) : transparent;
                    Text { text: "\u{00d7}"; horizontal-alignment: center; vertical-alignment: center; }
                    clear-ta := TouchArea { clicked => { root.close-filter(); } }
                }
            }
            // Switch the path bar between breadcrumb and text entry for good.
            Rectangle {
                x: parent.width - 24px;
                width: 24px;
                background: mode-ta.has-hover ? Palette.alternate-background.brighter(0.2) : transparent;
                Text {
                    // "..." edits the path as text; the chevron goes back to the breadcrumb.
                    text: root.entry-sticky ? "\u{203a}" : "...";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                mode-ta := TouchArea {
                    clicked => { root.toggle-sticky(); }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.back) { root.back-button(); }
                        if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.forward) { root.forward-button(); }
                    }
                }
            }
        }
        // One header per Type column state, chosen per pane like the list below: on, it is the
        // header as it was before the switch; off, the Type cell does not exist, so a header click
        // cannot sort by it. The grid has no columns: its header keeps only Name (the sort), and
        // its 24 px keep the list's top where dnd.rs LIST_TOP and the driver (auto.rs) expect it.
        if root.grid: HorizontalLayout {
            height: 24px;
            HeaderCell { label: "Name"; sorted: sort-col == 0; asc: sort-asc; clicked => { root.sort-by(0); } back => { root.back-button(); } forward => { root.forward-button(); } }
        }
        if root.show-type && !root.grid: HorizontalLayout {
            height: 24px;
            HeaderCell { label: "Name"; sorted: sort-col == 0; asc: sort-asc; clicked => { root.sort-by(0); } back => { root.back-button(); } forward => { root.forward-button(); } }
            HeaderCell { label: "Type"; width: 120px; sorted: sort-col == 3; asc: sort-asc; clicked => { root.sort-by(3); } back => { root.back-button(); } forward => { root.forward-button(); } }
            HeaderCell { label: "Size"; width: 90px; sorted: sort-col == 1; asc: sort-asc; clicked => { root.sort-by(1); } back => { root.back-button(); } forward => { root.forward-button(); } }
            HeaderCell { label: "Modified"; width: 140px; sorted: sort-col == 2; asc: sort-asc; clicked => { root.sort-by(2); } back => { root.back-button(); } forward => { root.forward-button(); } }
        }
        if !root.show-type && !root.grid: HorizontalLayout {
            height: 24px;
            HeaderCell { label: "Name"; sorted: sort-col == 0; asc: sort-asc; clicked => { root.sort-by(0); } back => { root.back-button(); } forward => { root.forward-button(); } }
            HeaderCell { label: "Size"; width: 90px; sorted: sort-col == 1; asc: sort-asc; clicked => { root.sort-by(1); } back => { root.back-button(); } forward => { root.forward-button(); } }
            HeaderCell { label: "Modified"; width: 140px; sorted: sort-col == 2; asc: sort-asc; clicked => { root.sort-by(2); } back => { root.back-button(); } forward => { root.forward-button(); } }
        }
        list := FileListHost {
            rows: root.rows;
            current-row <=> root.current-row;
            show-type: root.show-type;
            thumbnails: root.thumbnails;
            grid: root.grid;
            grid-rows: root.grid-rows;
            medium: root.medium;
            grid-cols(n) => { root.grid-cols(n); }
            grid-cursor(c) => { root.grid-cursor(c); }
            active: root.active;
            go-up => { root.go-up(); }
            history(f) => { root.history(f); }
            open-row(i) => { root.open-row(i); }
            focus-requested => { root.focus-requested(); }
            select(op, i) => { root.select(op, i); }
            viewport-changed(y, h) => { root.viewport-changed(y, h); }
            command(c) => { root.command(c); }
            context-menu(r, x, y, s) => { root.context-menu(r, x, y, s); }
            context-key(r, x, y, cy, h) => { root.context-key(r, x, y, cy, h); }
            row-gesture(r, w, c, s) => { root.row-gesture(r, w, c, s); }
            drag-dx: root.drag-dx;
            drag-dy: root.drag-dy;
        }
        HorizontalLayout {
            height: 18px;
            spacing: 12px;
            Text { text: root.status.left; font-size: 11px; color: Palette.foreground; overflow: elide; horizontal-stretch: 1; }
            Text { text: root.status.mid; font-size: 11px; color: Palette.foreground; horizontal-alignment: center; }
            Text { text: root.status.right; font-size: 11px; color: Palette.foreground; horizontal-alignment: right; }
        }
    }

    // Icons for every row in one image over the list's icon column (6 px in, as the rows'
    // padding), moved with the list through content-y, so a scroll of less than the strip's
    // margin repaints one image and recomposes nothing. Clipped to the list's viewport; no
    // input handling and no accessibility node, so clicks and the list's tree are the rows'.
    Rectangle {
        x: list.x;
        y: list.y;
        width: list.visible-width;
        height: list.visible-height;
        clip: true;
        visible: root.strip-shown;
        Image {
            x: root.strip-left;
            y: list.content-y + root.strip-top;
            width: root.strip-width;
            height: root.strip-height;
            source: root.strip;
            image-fit: fill;
            image-rendering: pixelated;
            accessible-role: none;
        }
    }
    Rectangle {
        x: list.x;
        y: list.y;
        width: list.visible-width;
        height: list.visible-height;
        clip: true;
        for s in root.strip-rows: Image {
            x: 0px;
            y: list.content-y + s.top;
            width: s.w;
            height: s.h;
            visible: s.shown;
            source: s.img;
            image-fit: fill;
            image-rendering: pixelated;
            accessible-role: none;
        }
    }

    // Drop highlight: the target row (the target tile in the grid), or the whole list when the drop
    // goes to the pane's folder. Overlays rather than per-row bindings, so the rows carry nothing
    // new; no input handling and no accessibility node.
    Rectangle {
        x: list.x;
        y: list.y;
        width: list.visible-width;
        height: list.visible-height;
        clip: true;
        visible: root.drop-here;
        Rectangle {
            visible: root.drop-row >= 0;
            x: list.col-of(root.drop-row) * list.tile-w;
            y: list.content-y + list.line-of(root.drop-row) * list.row-h;
            width: root.grid ? list.tile-w : parent.width;
            height: list.row-h;
            background: Palette.accent-background.transparentize(65%);
            border-width: 2px;
            border-color: Palette.accent-background;
        }
        Rectangle {
            visible: root.drop-row < 0;
            background: Palette.accent-background.transparentize(88%);
            border-width: 3px;
            border-color: Palette.accent-background;
        }
    }

    // The empty space below the last row (none when the rows fill the viewport): a right-click
    // there opens the folder's background menu ("New", "Paste", "Properties").
    // The rows' total height: no content-y in it, so it stays cached while the list scrolls.
    private property <length> rows-h: (root.grid ? root.grid-rows.length : root.rows.length) * list.row-h;
    private property <length> rows-end: max(0px, min(list.visible-height, list.content-y + root.rows-h));
    TouchArea {
        x: list.x;
        y: list.y + root.rows-end;
        width: list.visible-width;
        height: max(0px, list.visible-height - root.rows-end);
        pointer-event(ev) => {
            root.band-ev(ev, self.absolute-position.x, self.absolute-position.y, self.mouse-x, self.mouse-y);
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                list.focus-list();
                root.focus-requested();
                // Explorer: a right-click on empty space leaves nothing selected.
                root.select(5, -1);
            }
            if (ev.button == PointerEventButton.back && ev.kind == PointerEventKind.up) {
                root.back-button();
            }
            if (ev.button == PointerEventButton.forward && ev.kind == PointerEventKind.up) {
                root.forward-button();
            }
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.context-menu(-1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, ev.modifiers.shift);
            }
        }
    }

    // The grid's other empty space (P4-M3), where the band starts too: the gap right of the last
    // column (12 px short of the list's edge: Fluent's scrollbar overlays the content there) and the
    // gap after the last tile of a partial last grid row (under the list's clip, so a scrolled-away
    // row takes no input over the header). The ListView's scroll surface took left presses there.
    // Two overlays per pane, created only while the grid shows; the band's rectangle under the
    // same clip, drawn only while the band is on.
    if root.grid: Rectangle {
        x: list.x;
        y: list.y;
        width: list.visible-width;
        height: list.visible-height;
        clip: true;
        TouchArea {
            x: list.cols * list.tile-w;
            y: 0;
            width: max(0px, parent.width - 12px - self.x);
            height: parent.height;
            pointer-event(ev) => { root.band-ev(ev, self.absolute-position.x, self.absolute-position.y, self.mouse-x, self.mouse-y); }
        }
        TouchArea {
            x: mod(root.rows.length, list.cols) * list.tile-w;
            y: list.content-y + (root.grid-rows.length - 1) * list.tile-h;
            width: mod(root.rows.length, list.cols) == 0 ? 0px : (list.cols - mod(root.rows.length, list.cols)) * list.tile-w;
            height: list.tile-h;
            pointer-event(ev) => { root.band-ev(ev, self.absolute-position.x, self.absolute-position.y, self.mouse-x, self.mouse-y); }
        }
        Rectangle {
            visible: root.band-here;
            x: root.band-x;
            y: list.content-y + root.band-y;
            width: root.band-w;
            height: root.band-h;
            background: Palette.accent-background.transparentize(75%);
            border-width: 1px;
            border-color: Palette.accent-background;
        }
    }

    // Return commits, Escape cancels, focus loss cancels. Over the name cell: 6 px row padding
    // plus the icon slot (one row high, 22 or 32 px) from the left, the fixed columns (350 px, 230
    // px without Type) from the right, centred on the row. In the grid, over the tile's name (2 px
    // in, the tile's width less 4 px, centred on the 19 px text that ends 2 px above the tile's
    // bottom: 95 px down a large tile, 47 px down a medium one).
    // The opaque box hides the row text behind Fluent's translucent LineEdit background.
    Rectangle {
        visible: root.edit-mode != 0;
        x: list.x + (root.grid ? list.col-of(list.current-row) * list.tile-w + 2px : list.row-h + 2px + (root.thumbnails ? 4px : 0px));
        y: list.y + (root.grid ? list.tile-h - 25px : (list.row-h - 28px) / 2) + (root.edit-mode == 1 ? list.content-y + list.line-of(list.current-row) * list.row-h : 0px);
        width: root.grid ? list.tile-w - 4px : max(160px, list.width - list.row-h - 2px - (root.thumbnails ? 4px : 0px) - (root.show-type ? 350px : 230px) - 12px);
        height: 28px;
        background: Palette.background;
        // As behind the path entry: Back or Forward over the editor is ignored, not taken by the
        // row under it (P6-M3).
        TouchArea { }
        edit := LineEdit {
            width: 100%;
            height: 100%;
            accessible-label: root.edit-mode == 1 ? "Rename" : root.edit-mode == 3 ? "New file name" : "New folder name";
            accepted(t) => {
                root.edit-commit(root.edit-mode, root.edit-original, t);
                root.end-edit();
            }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.end-edit(); return accept; }
                return reject;
            }
            changed has-focus => {
                if (!self.has-focus && root.edit-mode != 0) { root.edit-mode = 0; }
            }
        }
    }
}
