import { ListView, LineEdit, Palette } from "std-widgets.slint";

// kind: 0 directory, 1 file, 2 drive, 3 reparse point (model::Kind)
export struct Row {
    name: string,
    type-text: string,
    size: string,
    modified: string,
    kind: int,
    selected: bool,
    // On the clipboard as a cut: the row's text is drawn dimmed.
    cut: bool,
}

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <bool> sorted;
    in property <bool> asc;
    callback clicked();
    background: ta.has-hover ? Palette.alternate-background.brighter(0.2) : Palette.alternate-background;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text { text: label; vertical-alignment: center; font-weight: 600; }
        Text { text: sorted ? (asc ? "\u{25b2}" : "\u{25bc}") : ""; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Same structure as Slint's StandardListView: a component inheriting ListView carries the list
// role itself, a zero-width FocusScope inside it holds keyboard focus, and
// accessible-delegate-focus makes assistive clients see focus on the current row.
// The base holds the single `for` a ListView allows; the derived component adds the focus scope,
// which is how StandardListView is layered too.
component FileListBase inherits ListView {
    in property <[Row]> rows;
    in-out property <int> current-row: -1;
    callback open-row(int);
    callback focus-requested();
    callback row-clicked(int, bool /* ctrl */, bool /* shift */);
    callback row-right-pressed(int);
    // context-menu(row, x, y, shift): right button released over a row (row >= 0) or the empty
    // space below the last row (-1), at window-relative logical coordinates.
    callback context-menu(int, length, length, bool);
    // row-gesture(row, what, ctrl, shift), the left button on a row, decided in Rust (dnd::Gesture):
    // what 0 press, 1 release, 2 moved past the drag threshold with the button down (once per
    // press), 3 double-click.
    callback row-gesture(int, int, bool, bool);
    // The drag threshold (SM_CXDRAG / SM_CYDRAG in logical px), set from Rust.
    in property <length> drag-dx: 4px;
    in property <length> drag-dy: 4px;
    // The drag gesture for the current press has been reported.
    private property <bool> drag-sent: false;

    accessible-label: "Files";
    accessible-item-count: rows.length;
    accessible-delegate-focus: max(0, current-row);

    for row[i] in rows: Rectangle {
        height: 22px;
        accessible-role: AccessibleRole.list-item;
        accessible-label: row.kind == 1 ? row.name + ", " + row.type-text + ", " + row.size + ", " + row.modified
            : row.name + ", " + row.type-text + (row.size == "" ? "" : ", " + row.size);
        accessible-item-selectable: true;
        accessible-item-selected: row.selected;
        accessible-item-index: i;
        background: row.selected ? Palette.selection-background : (mod(i, 2) == 0 ? Palette.background : Palette.alternate-background);
        // The cursor is an outline, so it stays visible on selected and unselected rows alike.
        border-width: i == current-row ? 1px : 0px;
        border-color: Palette.accent-background;
        HorizontalLayout {
            // 6 px padding plus the 22 px icon column; the icons are drawn by the pane's strip.
            padding-left: 28px;
            padding-right: 6px;
            Text { text: row.name; vertical-alignment: center; overflow: elide; color: row.cut ? Palette.foreground.transparentize(55%) : Palette.foreground; }
            Text { text: row.type-text; width: 120px; vertical-alignment: center; overflow: elide; color: row.cut ? Palette.foreground.transparentize(55%) : Palette.foreground; }
            Text { text: row.size; width: 90px; horizontal-alignment: right; vertical-alignment: center; color: row.cut ? Palette.foreground.transparentize(55%) : Palette.foreground; }
            Text { text: row.modified; width: 140px; horizontal-alignment: right; vertical-alignment: center; color: row.cut ? Palette.foreground.transparentize(55%) : Palette.foreground; }
        }
        TouchArea {
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    root.drag-sent = false;
                    root.row-clicked(i, ev.modifiers.control, ev.modifiers.shift);
                }
                if (ev.kind == PointerEventKind.move && self.pressed && !root.drag-sent
                    && (abs(self.mouse-x - self.pressed-x) > root.drag-dx || abs(self.mouse-y - self.pressed-y) > root.drag-dy)) {
                    root.drag-sent = true;
                    root.row-gesture(i, 2, false, false);
                }
                if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                    root.row-gesture(i, 1, ev.modifiers.control, ev.modifiers.shift);
                }
                // Select on the press (so the row is drawn selected before the menu's modal loop
                // starts), open the shell menu on the release.
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                    root.row-right-pressed(i);
                }
                if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.right) {
                    root.context-menu(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, ev.modifiers.shift);
                }
            }
            double-clicked => { root.row-gesture(i, 3, false, false); }
        }
    }
}

component FileList inherits FileListBase {
    callback go-up();
    // op: 0 only this row, 1 toggle, 2 range from anchor, 3 all (model::SelOp)
    callback select(int, int);
    // (content-y, visible-height) whenever the list scrolls, resizes or changes length; Rust
    // turns it into the visible row range and fetches icons for it.
    callback viewport-changed(length, length);
    // File operations on the active pane: copy, move, delete, sdelete, rename, newfolder, cc, cx, cv.
    callback command(string);
    // context-key(row, list x, list y, content-y, visible-height): Shift+F10 or the Menu key, after
    // the cursor row was scrolled into view; Rust places the menu under the row.
    callback context-key(int, length, length, length, length);
    private property <int> row-count: root.rows.length;
    changed content-y => { root.viewport-changed(root.content-y, root.visible-height); }
    changed visible-height => { root.viewport-changed(root.content-y, root.visible-height); }
    changed row-count => { root.viewport-changed(root.content-y, root.visible-height); }
    forward-focus: key-area;
    public function focus-list() { key-area.focus(); }

    // Same arithmetic as StandardListView's bring-into-view, for our 22px rows: scroll just far
    // enough that the cursor row is fully inside the viewport, then apply the selection gesture.
    public function bring-into-view() {
        if (root.current-row < 0) { return; }
        if (root.content-y + root.current-row * 22px < 0px) {
            root.content-y = -root.current-row * 22px;
        }
        if (root.content-y + (root.current-row + 1) * 22px > root.visible-height) {
            root.content-y = root.visible-height - (root.current-row + 1) * 22px;
        }
    }

    function cursor-moved(shift: bool) {
        if (root.current-row < 0) { return; }
        root.bring-into-view();
        root.select(shift ? 2 : 0, root.current-row);
    }

    // The selection a press makes (or defers to the release, so a drag carries the whole
    // selection) is Rust's decision: dnd::Gesture.
    row-clicked(i, ctrl, shift) => {
        root.current-row = i;
        key-area.focus();
        root.focus-requested();
        root.row-gesture(i, 0, ctrl, shift);
    }

    // Explorer's rule: an unselected row becomes the only selection, a selected row keeps it.
    row-right-pressed(i) => {
        root.current-row = i;
        key-area.focus();
        root.focus-requested();
        root.select(4, i);
    }

    key-area := FocusScope {
        x: 0;
        width: 0;
        key-pressed(e) => {
            if (e.text == Key.Backspace && !e.modifiers.control) { root.go-up(); return accept; }
            if (e.text == Key.UpArrow && e.modifiers.alt) { root.go-up(); return accept; }
            if (e.text == Key.Return) { if (root.current-row >= 0) { root.open-row(root.current-row); } return accept; }
            if (e.text == Key.UpArrow) {
                if (root.current-row > 0) { root.current-row -= 1; } else if (root.rows.length > 0) { root.current-row = 0; }
                root.cursor-moved(e.modifiers.shift);
                return accept;
            }
            if (e.text == Key.DownArrow) {
                if (root.current-row + 1 < root.rows.length) { root.current-row += 1; }
                root.cursor-moved(e.modifiers.shift);
                return accept;
            }
            if (e.text == Key.Home) { if (root.rows.length > 0) { root.current-row = 0; root.cursor-moved(e.modifiers.shift); } return accept; }
            if (e.text == Key.End) { if (root.rows.length > 0) { root.current-row = root.rows.length - 1; root.cursor-moved(e.modifiers.shift); } return accept; }
            // File operations live here, not in the window's outer scope, so they only fire while
            // the list has focus: a Delete typed into the path bar or the rename box stays text.
            if (e.text == Key.F5 && e.modifiers.shift) { root.command("copy"); return accept; }
            if (e.text == Key.F6 && e.modifiers.shift) { root.command("move"); return accept; }
            if (e.text == Key.Delete) { root.command(e.modifiers.shift ? "sdelete" : "delete"); return accept; }
            if (e.text == Key.F2) { root.command("rename"); return accept; }
            if ((e.text == Key.F10 && e.modifiers.shift) || e.text == Key.Menu) {
                root.bring-into-view();
                root.context-key(root.current-row, root.absolute-position.x, root.absolute-position.y, root.content-y, root.visible-height);
                return accept;
            }
            if (e.text == Key.F7 || (e.modifiers.control && e.modifiers.shift && (e.text == "n" || e.text == "N"))) {
                root.command("newfolder");
                return accept;
            }
            if (e.modifiers.control && !e.modifiers.shift && (e.text == "c" || e.text == "C")) { root.command("cc"); return accept; }
            if (e.modifiers.control && !e.modifiers.shift && (e.text == "x" || e.text == "X")) { root.command("cx"); return accept; }
            if (e.modifiers.control && !e.modifiers.shift && (e.text == "v" || e.text == "V")) { root.command("cv"); return accept; }
            if (e.text == " ") { if (root.current-row >= 0) { root.select(1, root.current-row); } return accept; }
            if (e.modifiers.control && (e.text == "a" || e.text == "A")) { root.select(3, root.current-row); return accept; }
            return reject;
        }
    }
}

export component Pane inherits Rectangle {
    in property <[Row]> rows;
    in-out property <string> path;
    in property <string> status;
    in property <bool> active;
    in property <int> sort-col: 0;
    in property <bool> sort-asc: true;
    in-out property <int> current-row: -1;

    callback navigate(string);
    callback open-row(int);
    callback sort-by(int);
    callback go-up();
    callback focus-requested();
    callback select(int, int);
    callback viewport-changed(length, length);
    callback command(string);
    // edit-commit(mode, original name, typed name): mode 1 rename, 2 new folder.
    callback edit-commit(int, string, string);
    callback context-menu(int, length, length, bool);
    callback context-key(int, length, length, length, length);
    callback row-gesture(int, int, bool, bool);
    in property <length> drag-dx: 4px;
    in property <length> drag-dy: 4px;
    // A drag is over this pane and would drop: on row `drop-row`, or (-1) into the pane's folder.
    in property <bool> drop-here: false;
    in property <int> drop-row: -1;

    // The inline name editor: 0 closed, 1 renaming the cursor row, 2 naming a new folder.
    in-out property <int> edit-mode: 0;
    private property <string> edit-original;

    // The icon strip (`set-strip`): one image holding the icons of rows strip-first onwards,
    // composed in Rust, at strip-width x strip-height logical px (its exact physical size).
    private property <image> strip;
    private property <int> strip-first;
    private property <length> strip-width;
    private property <length> strip-height;
    private property <bool> strip-shown: false;

    border-width: active ? 2px : 1px;
    border-color: active ? Palette.accent-background : Palette.border;
    background: Palette.background;

    forward-focus: list;
    public function focus-list() { list.focus-list(); }
    public function reset-scroll() { list.content-y = 0; current-row = -1; }
    public function get-scroll() -> length { return list.content-y; }
    public function set-scroll(y: length) { list.content-y = y; }
    public function set-strip(img: image, first: int, w: length, h: length, shown: bool) {
        strip = img;
        strip-first = first;
        strip-width = w;
        strip-height = h;
        strip-shown = shown;
    }

    // Open the name editor over the cursor row's name (rename) or the top row (new folder),
    // prefilled with `text` and all of it selected.
    public function begin-edit(mode: int, text: string) {
        if (mode == 1) { list.bring-into-view(); }
        root.edit-original = text;
        root.edit-mode = mode;
        edit.text = text;
        edit.focus();
        edit.select-all();
    }

    function end-edit() {
        root.edit-mode = 0;
        list.focus-list();
    }

    VerticalLayout {
        padding: 3px;
        spacing: 2px;
        path-edit := LineEdit {
            accessible-label: "Path";
            text <=> root.path;
            placeholder-text: "Path";
            accepted(s) => { root.navigate(s); }
        }
        HorizontalLayout {
            height: 24px;
            HeaderCell { label: "Name"; sorted: sort-col == 0; asc: sort-asc; clicked => { root.sort-by(0); } }
            HeaderCell { label: "Type"; width: 120px; sorted: sort-col == 3; asc: sort-asc; clicked => { root.sort-by(3); } }
            HeaderCell { label: "Size"; width: 90px; sorted: sort-col == 1; asc: sort-asc; clicked => { root.sort-by(1); } }
            HeaderCell { label: "Modified"; width: 140px; sorted: sort-col == 2; asc: sort-asc; clicked => { root.sort-by(2); } }
        }
        list := FileList {
            rows: root.rows;
            current-row <=> root.current-row;
            go-up => { root.go-up(); }
            open-row(i) => { root.open-row(i); }
            focus-requested => { root.focus-requested(); }
            select(op, i) => { root.select(op, i); }
            viewport-changed(y, h) => { root.viewport-changed(y, h); }
            command(c) => { root.command(c); }
            context-menu(r, x, y, s) => { root.context-menu(r, x, y, s); }
            context-key(r, x, y, cy, h) => { root.context-key(r, x, y, cy, h); }
            row-gesture(r, w, c, s) => { root.row-gesture(r, w, c, s); }
            drag-dx: root.drag-dx;
            drag-dy: root.drag-dy;
        }
        Text { text: status; height: 18px; font-size: 11px; color: Palette.foreground; }
    }

    // Icons for every row in one image over the list's icon column (6 px in, as the rows'
    // padding), moved with the list through content-y, so a scroll of less than the strip's
    // margin repaints one image and recomposes nothing. Clipped to the list's viewport; no
    // input handling and no accessibility node, so clicks and the list's tree are the rows'.
    Rectangle {
        x: list.x;
        y: list.y;
        width: list.visible-width;
        height: list.visible-height;
        clip: true;
        visible: root.strip-shown;
        Image {
            x: 6px;
            y: list.content-y + root.strip-first * 22px;
            width: root.strip-width;
            height: root.strip-height;
            source: root.strip;
            image-fit: fill;
            image-rendering: pixelated;
            accessible-role: none;
        }
    }

    // Drop highlight: the target row, or the whole list when the drop goes to the pane's folder.
    // Overlays rather than per-row bindings, so the rows carry nothing new; no input handling and
    // no accessibility node.
    Rectangle {
        x: list.x;
        y: list.y;
        width: list.visible-width;
        height: list.visible-height;
        clip: true;
        visible: root.drop-here;
        Rectangle {
            visible: root.drop-row >= 0;
            x: 0;
            y: list.content-y + root.drop-row * 22px;
            width: parent.width;
            height: 22px;
            background: Palette.accent-background.transparentize(65%);
            border-width: 2px;
            border-color: Palette.accent-background;
        }
        Rectangle {
            visible: root.drop-row < 0;
            background: Palette.accent-background.transparentize(88%);
            border-width: 3px;
            border-color: Palette.accent-background;
        }
    }

    // The empty space below the last row (none when the rows fill the viewport): a right-click
    // there opens the folder's background menu ("New", "Paste", "Properties").
    private property <length> rows-end: max(0px, min(list.visible-height, list.content-y + root.rows.length * 22px));
    TouchArea {
        x: list.x;
        y: list.y + root.rows-end;
        width: list.visible-width;
        height: max(0px, list.visible-height - root.rows-end);
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                list.focus-list();
                root.focus-requested();
            }
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.context-menu(-1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, ev.modifiers.shift);
            }
        }
    }

    // Return commits, Escape cancels, focus loss cancels. Over the name cell: 6 px row padding
    // plus the 22 px icon slot from the left, the three fixed columns (350 px) from the right.
    // The opaque box hides the row text behind Fluent's translucent LineEdit background.
    Rectangle {
        visible: root.edit-mode != 0;
        x: list.x + 24px;
        y: list.y - 3px + (root.edit-mode == 1 ? list.content-y + list.current-row * 22px : 0px);
        width: max(160px, list.width - 24px - 350px - 12px);
        height: 28px;
        background: Palette.background;
        edit := LineEdit {
            width: 100%;
            height: 100%;
            accessible-label: root.edit-mode == 1 ? "Rename" : "New folder name";
            accepted(t) => {
                root.edit-commit(root.edit-mode, root.edit-original, t);
                root.end-edit();
            }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.end-edit(); return accept; }
                return reject;
            }
            changed has-focus => {
                if (!self.has-focus && root.edit-mode != 0) { root.edit-mode = 0; }
            }
        }
    }
}
