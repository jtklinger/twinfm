import { ListView, LineEdit, Palette } from "std-widgets.slint";

// kind: 0 directory, 1 file, 2 drive, 3 other reparse point, 4 junction, 5 symbolic link,
// 6 cloud placeholder, 7 app execution alias (model::Kind)
export struct Row {
    name: string,
    type-text: string,
    size: string,
    modified: string,
    kind: int,
    selected: bool,
    // On the clipboard as a cut: the row's text is drawn dimmed.
    cut: bool,
}

// The large-icon grid (P4-M1, from the P3-M5 trace's variant b): one tile per entry, `GridRow.tiles`
// of them to a grid row, the grid row's first entry index in `first` (model.rs GridModel). The
// tile carries what it draws; `current` is the cursor, decided in Rust, so no tile binds to a root
// property.
export struct Tile {
    name: string,
    selected: bool,
    cut: bool,
    current: bool,
}

export struct GridRow {
    first: int,
    tiles: [Tile],
}

// One grid row of the grid's icon strip (main.rs `compose_grid_row`): its image, the row's top in
// the list's content, the image's logical size, and whether it holds a row at all.
export struct StripRow {
    img: image,
    top: length,
    w: length,
    h: length,
    shown: bool,
}

// One tab in a pane's tab strip (main.rs rebuilds the list on change only).
export struct TabInfo {
    title: string,
    active: bool,
}

// One breadcrumb button; a click navigates to the path up to and including it (pathbar.rs).
export struct Crumb {
    label: string,
}

// The pane's status bar: items and hidden count, the selection, the volume's free space.
export struct StatusInfo {
    left: string,
    mid: string,
    right: string,
}

// Which toolbar buttons apply to a pane (toolbar.rs `state`, set from Rust in update_status's
// rhythm, on change only).
export struct ToolState {
    new: bool,
    cut: bool,
    copy: bool,
    paste: bool,
    rename: bool,
    delete: bool,
}

// One toolbar button: a Segoe Fluent Icons glyph (the font of Explorer's own command bar, part of
// Windows 11), with its label beside it in the toolbar across the window. A disabled button is
// dimmed and takes no clicks.
component ToolButton inherits Rectangle {
    in property <string> glyph;
    in property <string> text;
    in property <bool> labelled;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    border-radius: 4px;
    background: !root.enabled ? transparent : ta.pressed ? Palette.alternate-background.darker(0.1) : ta.has-hover ? Palette.alternate-background.brighter(0.2) : transparent;
    HorizontalLayout {
        padding-left: root.labelled ? 8px : 6px;
        padding-right: root.labelled ? 10px : 6px;
        spacing: 6px;
        Text {
            text: root.glyph;
            font-family: "Segoe Fluent Icons";
            font-size: 16px;
            vertical-alignment: center;
            color: root.enabled ? Palette.foreground : Palette.foreground.transparentize(65%);
        }
        if root.labelled: Text {
            text: root.text;
            vertical-alignment: center;
            color: root.enabled ? Palette.foreground : Palette.foreground.transparentize(65%);
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component ToolSeparator inherits Rectangle {
    width: 9px;
    Rectangle { x: 4px; y: 5px; width: 1px; height: parent.height - 10px; background: Palette.border; }
}

// The toolbar (P6-M3), in its three groups: New file, New folder; Cut, Copy, Paste; Rename, Delete.
// tool(name) names the button (toolbar.rs `command` maps it to its key's command).
export component Toolbar inherits HorizontalLayout {
    in property <ToolState> tools;
    in property <bool> labelled;
    callback tool(string);
    alignment: start;
    padding: 2px;
    spacing: 2px;
    ToolButton { glyph: "\u{E8A5}"; text: "New file"; labelled: root.labelled; enabled: root.tools.new; clicked => { root.tool("newfile"); } }
    ToolButton { glyph: "\u{E8F4}"; text: "New folder"; labelled: root.labelled; enabled: root.tools.new; clicked => { root.tool("newfolder"); } }
    ToolSeparator { }
    ToolButton { glyph: "\u{E8C6}"; text: "Cut"; labelled: root.labelled; enabled: root.tools.cut; clicked => { root.tool("cut"); } }
    ToolButton { glyph: "\u{E8C8}"; text: "Copy"; labelled: root.labelled; enabled: root.tools.copy; clicked => { root.tool("copy"); } }
    ToolButton { glyph: "\u{E77F}"; text: "Paste"; labelled: root.labelled; enabled: root.tools.paste; clicked => { root.tool("paste"); } }
    ToolSeparator { }
    ToolButton { glyph: "\u{E8AC}"; text: "Rename"; labelled: root.labelled; enabled: root.tools.rename; clicked => { root.tool("rename"); } }
    ToolButton { glyph: "\u{E74D}"; text: "Delete"; labelled: root.labelled; enabled: root.tools.delete; clicked => { root.tool("delete"); } }
}

// One tab; the strip places and sizes it. The left press activates it (as browsers do), and
// moving with the button held reports the pointer's x inside the tab, for the strip's reorder.
component TabButton inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    callback pressed();
    callback released();
    callback drag-moved(length);
    callback close();
    background: active ? Palette.background : (ta.has-hover ? Palette.alternate-background.brighter(0.2) : Palette.alternate-background);
    border-width: 1px;
    border-color: active ? Palette.accent-background : Palette.border;
    ta := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) { root.pressed(); }
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) { root.released(); }
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.middle) { root.close(); }
        }
        moved => {
            if (self.pressed) { root.drag-moved(self.mouse-x); }
        }
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 2px;
        spacing: 2px;
        Text { text: root.title; vertical-alignment: center; overflow: elide; font-weight: root.active ? 600 : 400; }
        Rectangle {
            width: 18px;
            background: close-ta.has-hover ? Palette.alternate-background.darker(0.2) : transparent;
            Text { text: "\u{00d7}"; horizontal-alignment: center; vertical-alignment: center; }
            close-ta := TouchArea { clicked => { root.close(); } }
        }
    }
}

// One breadcrumb: the label navigates there; the chevron after it opens the dropdown of its
// subfolders (the next crumb's siblings), as in Explorer.
component CrumbButton inherits HorizontalLayout {
    in property <string> label;
    callback clicked();
    // menu(x, y): the chevron, at window coordinates of its bottom-left corner.
    callback menu(length, length);
    // The mouse's Back or Forward button released over the crumb (every TouchArea grabs the press
    // it gets, so each one in the pane reports it).
    callback back();
    callback forward();
    // A drag over the label would drop into this crumb's folder (P5-M3): lit as a tab is.
    in property <bool> drop-here: false;
    // geometry(x, width): the crumb's x in the crumb row and its label's width, for the drop
    // target's hit test (main.rs `crumb_geometry`). Reported when the crumb is made and when
    // either changes (`changed` runs once per change, never per frame).
    callback geometry(length, length);
    init => { root.geometry(root.x, label-box.width); }
    changed x => { root.geometry(root.x, label-box.width); }
    label-box := Rectangle {
        background: root.drop-here ? Palette.accent-background.transparentize(65%) : ta.has-hover ? Palette.alternate-background.brighter(0.2) : transparent;
        border-width: root.drop-here ? 2px : 0px;
        border-color: Palette.accent-background;
        changed width => { root.geometry(root.x, self.width); }
        ta := TouchArea {
            clicked => { root.clicked(); }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.back) { root.back(); }
                if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.forward) { root.forward(); }
            }
        }
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            Text { text: root.label; vertical-alignment: center; }
        }
    }
    Rectangle {
        width: 16px;
        background: chevron-ta.has-hover ? Palette.alternate-background.brighter(0.2) : transparent;
        Text { text: "\u{203a}"; horizontal-alignment: center; vertical-alignment: center; color: Palette.foreground.transparentize(40%); }
        chevron-ta := TouchArea {
            clicked => { root.menu(self.absolute-position.x, self.absolute-position.y + self.height); }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.back) { root.back(); }
                if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.forward) { root.forward(); }
            }
        }
    }
}

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <bool> sorted;
    in property <bool> asc;
    callback clicked();
    // The mouse's Back or Forward button released over the header cell.
    callback back();
    callback forward();
    background: ta.has-hover ? Palette.alternate-background.brighter(0.2) : Palette.alternate-background;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text { text: label; vertical-alignment: center; font-weight: 600; }
        Text { text: sorted ? (asc ? "\u{25b2}" : "\u{25bc}") : ""; vertical-alignment: center; }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.back) { root.back(); }
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.forward) { root.forward(); }
        }
    }
}

// Same structure as Slint's StandardListView: a component inheriting ListView carries the list
// role itself, a zero-width FocusScope inside it holds keyboard focus, and
// accessible-delegate-focus makes assistive clients see focus on the current row.
// The base holds the single `for` a ListView allows; the derived component adds the focus scope,
// which is how StandardListView is layered too.
// Two such lists exist, with the Type column (FileRows, FileList) and without it (FileRowsNoType,
// FileListNoType); FileListHost shows one per pane, so no row binds to the switch (a binding on
// it per row cost 0.7 of a point on the gate, a conditional cell per row 1.5). The rows and the
// focus layer are all each variant holds; the state and the logic live in the host, once. Each
// has a 32 px copy for thumbnails (FileRows32 and the rest, below).
component FileRows inherits ListView {
    in property <[Row]> rows;
    in property <int> current-row: -1;
    // row-pointer(row, event, left button held, mouse x, mouse y, pressed x, pressed y, window x,
    // window y of the row's TouchArea): FileListHost.row-pointer decides what it means.
    callback row-pointer(int, PointerEvent, bool, length, length, length, length, length, length);
    callback row-gesture(int, int, bool, bool);

    accessible-label: "Files";
    accessible-item-count: rows.length;
    accessible-delegate-focus: max(0, current-row);

    for row[i] in rows: Rectangle {
        height: 22px;
        accessible-role: AccessibleRole.list-item;
        // Files of every kind (plain, cloud placeholder, link, alias) have a size and a time;
        // folders have no size, drives no time. The type text names a junction or a link.
        accessible-label: row.size != "" && row.modified != "" ? row.name + ", " + row.type-text + ", " + row.size + ", " + row.modified
            : row.name + ", " + row.type-text + (row.size == "" ? "" : ", " + row.size);
        accessible-item-selectable: true;
        accessible-item-selected: row.selected;
        accessible-item-index: i;
        background: row.selected ? Palette.selection-background : (mod(i, 2) == 0 ? Palette.background : Palette.alternate-background);
        // The cursor is an outline, so it stays visible on selected and unselected rows alike.
        border-width: i == current-row ? 1px : 0px;
        border-color: Palette.accent-background;
        HorizontalLayout {
            // 6 px padding plus the 22 px icon column; the icons are drawn by the pane's strip.
            padding-left: 28px;
            padding-right: 6px;
            Text { text: row.name; vertical-alignment: center; overflow: elide; color: row.cut ? Palette.foreground.transparentize(55%) : Palette.foreground; }
            Text { text: row.type-text; width: 120px; vertical-alignment: center; overflow: elide; color: row.cut ? Palette.foreground.transparentize(55%) : Palette.foreground; }
            Text { text: row.size; width: 90px; horizontal-alignment: right; vertical-alignment: center; color: row.cut ? Palette.foreground.transparentize(55%) : Palette.foreground; }
            Text { text: row.modified; width: 140px; horizontal-alignment: right; vertical-alignment: center; color: row.cut ? Palette.foreground.transparentize(55%) : Palette.foreground; }
        }
        TouchArea {
            pointer-event(ev) => { root.row-pointer(i, ev, self.pressed, self.mouse-x, self.mouse-y, self.pressed-x, self.pressed-y, self.absolute-position.x, self.absolute-position.y); }
            double-clicked => { root.row-gesture(i, 3, false, false); }
        }
    }
}

// FileRows without the Type cell; the Name column takes its width. The accessible label still
// names the type (it is evaluated only when the accessibility tree asks for it).
component FileRowsNoType inherits ListView {
    in property <[Row]> rows;
    in property <int> current-row: -1;
    callback row-pointer(int, PointerEvent, bool, length, length, length, length, length, length);
    callback row-gesture(int, int, bool, bool);

    accessible-label: "Files";
    accessible-item-count: rows.length;
    accessible-delegate-focus: max(0, current-row);

    for row[i] in rows: Rectangle {
        height: 22px;
        accessible-role: AccessibleRole.list-item;
        accessible-label: row.size != "" && row.modified != "" ? row.name + ", " + row.type-text + ", " + row.size + ", " + row.modified
            : row.name + ", " + row.type-text + (row.size == "" ? "" : ", " + row.size);
        accessible-item-selectable: true;
        accessible-item-selected: row.selected;
        accessible-item-index: i;
        background: row.selected ? Palette.selection-background : (mod(i, 2) == 0 ? Palette.background : Palette.alternate-background);
        border-width: i == current-row ? 1px : 0px;
        border-color: Palette.accent-background;
        HorizontalLayout {
            padding-left: 28px;
            padding-right: 6px;
            Text { text: row.name; vertical-alignment: center; overflow: elide; color: row.cut ? Palette.foreground.transparentize(55%) : Palette.foreground; }
            Text { text: row.size; width: 90px; horizontal-alignment: right; vertical-alignment: center; color: row.cut ? Palette.foreground.transparentize(55%) : Palette.foreground; }
            Text { text: row.modified; width: 140px; horizontal-alignment: right; vertical-alignment: center; color: row.cut ? Palette.foreground.transparentize(55%) : Palette.foreground; }
        }
        TouchArea {
            pointer-event(ev) => { root.row-pointer(i, ev, self.pressed, self.mouse-x, self.mouse-y, self.pressed-x, self.pressed-y, self.absolute-position.x, self.absolute-position.y); }
            double-clicked => { root.row-gesture(i, 3, false, false); }
        }
    }
}

// The focus layer. FileListHost cannot reach inside its `if`, so it asks for the focus by bumping
// focus-request; a list created while its pane is active (the Type column switched, which drops
// the list that had the focus, or the pane split) takes the focus itself.
// A new list starts at the host's content-y, but the Flickable checks its bounds on the next turn
// of the event loop, before the ListView's first layout has set content-height, and would scroll
// it back to the top; so init sets content-height to what that layout will (22 px rows).
component FileList inherits FileRows {
    in property <int> focus-request;
    in property <bool> focus-on-init;
    callback key(KeyEvent) -> EventResult;
    forward-focus: key-area;
    init => {
        root.content-height = root.rows.length * 22px;
        if (root.focus-on-init) { key-area.focus(); }
    }
    changed focus-request => { key-area.focus(); }
    key-area := FocusScope {
        x: 0;
        width: 0;
        key-pressed(e) => { return root.key(e); }
    }
}

component FileListNoType inherits FileRowsNoType {
    in property <int> focus-request;
    in property <bool> focus-on-init;
    callback key(KeyEvent) -> EventResult;
    forward-focus: key-area;
    init => {
        root.content-height = root.rows.length * 22px;
        if (root.focus-on-init) { key-area.focus(); }
    }
    changed focus-request => { key-area.focus(); }
    key-area := FocusScope {
        x: 0;
        width: 0;
        key-pressed(e) => { return root.key(e); }
    }
}

// The four components above with 32 px rows and a 32 px icon column and a 4 px gap (42 px of left padding), for
// thumbnails (settings `thumbnails`). Copies, not a row height bound to a property: the height of
// a row is a constant of its component, and FileListHost chooses the component once per pane.
component FileRows32 inherits ListView {
    in property <[Row]> rows;
    in property <int> current-row: -1;
    // row-pointer(row, event, left button held, mouse x, mouse y, pressed x, pressed y, window x,
    // window y of the row's TouchArea): FileListHost.row-pointer decides what it means.
    callback row-pointer(int, PointerEvent, bool, length, length, length, length, length, length);
    callback row-gesture(int, int, bool, bool);

    accessible-label: "Files";
    accessible-item-count: rows.length;
    accessible-delegate-focus: max(0, current-row);

    for row[i] in rows: Rectangle {
        height: 32px;
        accessible-role: AccessibleRole.list-item;
        // Files of every kind (plain, cloud placeholder, link, alias) have a size and a time;
        // folders have no size, drives no time. The type text names a junction or a link.
        accessible-label: row.size != "" && row.modified != "" ? row.name + ", " + row.type-text + ", " + row.size + ", " + row.modified
            : row.name + ", " + row.type-text + (row.size == "" ? "" : ", " + row.size);
        accessible-item-selectable: true;
        accessible-item-selected: row.selected;
        accessible-item-index: i;
        background: row.selected ? Palette.selection-background : (mod(i, 2) == 0 ? Palette.background : Palette.alternate-background);
        // The cursor is an outline, so it stays visible on selected and unselected rows alike.
        border-width: i == current-row ? 1px : 0px;
        border-color: Palette.accent-background;
        HorizontalLayout {
            // 6 px padding plus the 32 px icon column; the icons are drawn by the pane's strip.
            padding-left: 42px;
            padding-right: 6px;
            Text { text: row.name; vertical-alignment: center; overflow: elide; color: row.cut ? Palette.foreground.transparentize(55%) : Palette.foreground; }
            Text { text: row.type-text; width: 120px; vertical-alignment: center; overflow: elide; color: row.cut ? Palette.foreground.transparentize(55%) : Palette.foreground; }
            Text { text: row.size; width: 90px; horizontal-alignment: right; vertical-alignment: center; color: row.cut ? Palette.foreground.transparentize(55%) : Palette.foreground; }
            Text { text: row.modified; width: 140px; horizontal-alignment: right; vertical-alignment: center; color: row.cut ? Palette.foreground.transparentize(55%) : Palette.foreground; }
        }
        TouchArea {
            pointer-event(ev) => { root.row-pointer(i, ev, self.pressed, self.mouse-x, self.mouse-y, self.pressed-x, self.pressed-y, self.absolute-position.x, self.absolute-position.y); }
            double-clicked => { root.row-gesture(i, 3, false, false); }
        }
    }
}

