// The look (P10-M1): the design language of rust-ui.com (shadcn/ui ported to Dioxus), copied as
// tokens, since none of its components can run in Slint. A neutral grey scale with no accent
// colour, hairline borders, 6 px radii on controls and 10 px on cards, light or dark following
// the system through Palette.color-scheme (the backend sets it from Windows' app mode). Every
// colour the window draws is read from here; std-widgets still in use (ListView, LineEdit,
// ComboBox, AboutSlint, ScrollView) keep their fluent drawing until replaced. The values are the
// design's (docs/phase-9-plan.md § P10-M1 The design).
import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    // Surfaces.
    out property <brush> ground: dark ? #0A0A0A : #FFFFFF;
    out property <brush> card: dark ? #171717 : #FFFFFF;
    out property <brush> sidebar: dark ? #171717 : #FAFAFA;
    // The muted fill: selected rows, the tab strip, hover on ghost buttons and sidebar rows.
    out property <brush> muted: dark ? #262626 : #F5F5F5;
    out property <brush> muted-half: dark ? #26262680 : #F5F5F580;
    // Text.
    out property <brush> fg: dark ? #FAFAFA : #0A0A0A;
    out property <brush> fg-muted: dark ? #A3A3A3 : #737373;
    out property <brush> fg-faint: dark ? #FAFAFA80 : #0A0A0A80;
    // Lines and rings.
    out property <brush> border: dark ? #FFFFFF1A : #E5E5E5;
    // An unchecked switch's track (shadcn's input colour).
    out property <brush> input: dark ? #FFFFFF26 : #E5E5E5;
    out property <brush> ring: dark ? #737373 : #A3A3A3;
    out property <brush> ring-half: dark ? #73737380 : #A3A3A380;
    out property <brush> ring-soft: dark ? #73737340 : #A3A3A340;
    // The active tab's lifted segment, the one place the card colour is not enough in dark mode.
    out property <brush> tab-active: dark ? #3F3F3F : #FFFFFF;
    // The one primary button per dialog.
    out property <brush> primary: dark ? #E5E5E5 : #171717;
    out property <brush> primary-fg: dark ? #171717 : #FAFAFA;
    // The 1 px shadow line under a lifted segment or an outline control (never drop-shadow).
    out property <brush> shadow: dark ? #00000066 : #0000001A;
    // Links in the preview's text (shadcn's prose links; the grey scale has no colour for them).
    out property <brush> link: dark ? #60A5FA : #2563EB;
    // Jeremy's console check (2026-10-22): the cursor and the selection were hard to see in grey.
    // The Windows accent (Palette.accent-background, the system's, lightened for dark mode by the
    // fluent style) draws the cursor ring and tints the selection; hover stays muted.
    out property <brush> accent: Palette.accent-background;
    out property <brush> cursor: Palette.accent-background;
    out property <brush> selection: dark ? Palette.accent-background.transparentize(72%) : Palette.accent-background.transparentize(78%);
    out property <length> radius: 6px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 10px;
}

// A button in the look (P10-M1): outline (a hairline, the card colour, the muted fill on hover)
// or primary (near-black, one per dialog). 32 px high, 13 px text at weight 500, 6 px corners.
export component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    callback clicked();
    height: 32px;
    width: layout.preferred-width;
    border-radius: Theme.radius;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border;
    background: root.primary ? (ta.has-hover ? Theme.primary.transparentize(10%) : Theme.primary) : (ta.has-hover ? Theme.muted : Theme.card);
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    layout := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text { text: root.text; vertical-alignment: center; font-weight: 500; color: root.primary ? Theme.primary-fg : Theme.fg; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// A switch for a boolean setting (P10-M1), in place of a check box: a 36 x 20 track with a 16 px
// knob, the label beside it. A click flips `checked` and calls toggled(), as the std CheckBox did.
export component Switch inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    callback toggled();
    height: 24px;
    width: layout.preferred-width;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => { root.checked = !root.checked; root.toggled(); }
    layout := HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 36px;
            y: (parent.height - 20px) / 2;
            height: 20px;
            border-radius: 10px;
            background: root.checked ? Theme.primary : Theme.input;
            Rectangle {
                x: root.checked ? 18px : 2px;
                y: 2px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: root.checked ? Theme.primary-fg : (Theme.dark ? Theme.fg : Theme.card);
                animate x { duration: 100ms; }
            }
        }
        Text { text: root.text; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.checked = !root.checked; root.toggled(); } }
}

// A text field in the look (P10-M3): a TextInput in an outline Rectangle, the surface the fluent
// LineEdit offered where TwinFM used it (text, placeholder, accepted, edited, key-pressed,
// has-focus, focus and select-all). `label` is the input's accessible label.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <string> label;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);
    callback key-pressed(KeyEvent) -> EventResult;
    // focus() on the field goes to the input (a component cannot define focus() itself).
    forward-focus: input;
    public function select-all() { input.select-all(); }
    height: 32px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.cursor : Theme.border;
    border-radius: Theme.radius;
    background: Theme.card;
    clip: true;
    // The press lands in the input wherever it falls in the field.
    TouchArea { clicked => { input.focus(); } }
    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        single-line: true;
        vertical-alignment: center;
        font-size: 13px;
        color: Theme.fg;
        selection-background-color: Theme.selection;
        selection-foreground-color: Theme.fg;
        accessible-label: root.label;
        text <=> root.text;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
        key-pressed(e) => { root.key-pressed(e) }
    }
    if root.text == "": Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.placeholder-text;
        vertical-alignment: center;
        overflow: elide;
        font-size: 13px;
        color: Theme.fg-muted;
    }
}

// A choice in the look (P10-M3): the current option and a chevron on an outline button; a click,
// Space or Return opens the options under it (the window's own popup, so it works inside the
// Settings dialog's popup as the fluent ComboBox did); Up and Down move the choice without opening.
// selected() fires after current-index changed, as the ComboBox's did.
export component Choice inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <string> label;
    callback selected();
    height: 32px;
    min-width: 120px;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.cursor : (ta.has-hover ? Theme.ring : Theme.border);
    border-radius: Theme.radius;
    background: Theme.card;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.model[root.current-index];
    accessible-action-default => { popup.show(); }
    function step(by: int) {
        let next = max(0, min(root.model.length - 1, root.current-index + by));
        if (next != root.current-index) {
            root.current-index = next;
            root.selected();
        }
    }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.DownArrow) { root.step(1); return accept; }
            if (e.text == Key.UpArrow) { root.step(-1); return accept; }
            if (e.text == Key.Return || e.text == " ") { popup.show(); return accept; }
            return reject;
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        Text { text: root.model[root.current-index]; vertical-alignment: center; overflow: elide; font-size: 13px; color: Theme.fg; horizontal-stretch: 1; }
        Rectangle {
            width: 14px;
            Image { y: (parent.height - 14px) / 2; width: 14px; height: 14px; source: @image-url("icons/chevron-down.svg"); colorize: Theme.fg-muted; }
        }
    }
    ta := TouchArea { clicked => { fs.focus(); popup.show(); } }
    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;
        Rectangle {
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000033;
            VerticalLayout {
                padding: 4px;
                for opt[i] in root.model: Rectangle {
                    height: 32px;
                    border-radius: Theme.radius;
                    background: i == root.current-index ? Theme.selection : (ota.has-hover ? Theme.muted : transparent);
                    accessible-role: button;
                    accessible-label: opt;
                    Text { x: 8px; width: parent.width - 16px; height: parent.height; text: opt; vertical-alignment: center; overflow: elide; font-size: 13px; color: Theme.fg; }
                    ota := TouchArea {
                        clicked => {
                            root.current-index = i;
                            root.selected();
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}
