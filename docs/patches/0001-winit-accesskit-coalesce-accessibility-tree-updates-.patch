From f6900e788a13473fc1b9c5861b876544618c44b9 Mon Sep 17 00:00:00 2001
From: Jeremy Klinger <jtklinger96@gmail.com>
Date: Fri, 9 Oct 2026 11:04:52 -0400
Subject: [PATCH] winit/accesskit: coalesce accessibility tree updates behind a
 short delay

On Windows a UI Automation client (TextInputHost.exe on every desktop) keeps the
AccessKit adapter active. During a 60 Hz ListView scroll every frame destroys rows
that left the viewport (full reload_tree) and moves every visible row (dirty-node
rebuild), and each update raises UIA property-changed events. With zero-delay timers
that is a full tree rebuild plus an event storm per frame: on a 40,000-row list the
accessibility work alone took 1.6 s of main-thread CPU per 10 s of scrolling.

Schedule both update paths on a short single-shot timer (50 ms, overridable with
SLINT_ACCESSKIT_UPDATE_DELAY_MS for experiments) instead. reload_tree already dedups
through pending_update, so this bounds the work to about 20 updates per second. On
the same scenario the accessibility share fell from 1645 ms to 507 ms per 10 s and
the main thread from 30.5% to 19.1% busy; Narrator still reads and announces rows
with no perceptible lag.

Related: #3867.

diff --git a/internal/backends/winit/accesskit.rs b/internal/backends/winit/accesskit.rs
index c064ea167..780c3e199 100644
--- a/internal/backends/winit/accesskit.rs
+++ b/internal/backends/winit/accesskit.rs
@@ -305,7 +305,7 @@ fn invoke_later(
         callback: impl FnOnce(&std::cell::RefCell<Self>, Weak<WinitWindowAdapter>) + 'static,
     ) {
         let win = self.window_adapter_weak.clone();
-        i_slint_core::timers::Timer::single_shot(Default::default(), move || {
+        i_slint_core::timers::Timer::single_shot(accessibility_update_delay(), move || {
             WinitWindowAdapter::with_access_kit_adapter_from_weak_window_adapter(
                 win.clone(),
                 move |self_cell| callback(self_cell, win),
@@ -314,6 +314,21 @@ fn invoke_later(
     }
 }
 
+/// Accessibility tree updates are coalesced behind this delay instead of running on the next
+/// event-loop turn. During a 60 Hz scroll every frame destroys rows that left the viewport
+/// (full `reload_tree`) and moves every visible row (dirty-node rebuild); with a zero delay
+/// both ran, and raised UIA property-changed events, on every frame. Assistive clients do
+/// not consume updates at frame rate, and `reload_tree` already dedups through
+/// `pending_update`, so a short delay bounds the work to at most ~20 updates per second.
+/// Override with `SLINT_ACCESSKIT_UPDATE_DELAY_MS` for experiments (0 restores the old behavior).
+fn accessibility_update_delay() -> core::time::Duration {
+    static DELAY_MS: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
+    let ms = *DELAY_MS.get_or_init(|| {
+        std::env::var("SLINT_ACCESSKIT_UPDATE_DELAY_MS").ok().and_then(|v| v.parse().ok()).unwrap_or(50)
+    });
+    core::time::Duration::from_millis(ms)
+}
+
 const NODE_ID_INDEX_BITS: u32 = 16;
 const NODE_ID_INDEX_MASK: u64 = (1 << NODE_ID_INDEX_BITS) - 1; // 0xFFFF
 const NODE_ID_COMPONENT_BITS: u32 = 22;
@@ -963,7 +978,7 @@ struct AccessibilityPropertyDirtyHandler {
 impl i_slint_core::properties::PropertyDirtyHandler for AccessibilityPropertyDirtyHandler {
     fn notify(self: Pin<&Self>) {
         let win = self.window_adapter_weak.clone();
-        i_slint_core::timers::Timer::single_shot(Default::default(), move || {
+        i_slint_core::timers::Timer::single_shot(accessibility_update_delay(), move || {
             WinitWindowAdapter::with_access_kit_adapter_from_weak_window_adapter(
                 win,
                 |self_cell| {
